---
import Topbar from "@/components/Topbar.astro";
import { buttonVariants } from "@/components/ui/button";
import { getMessages } from "@/lib/i18n";
import { cn } from "@/lib/utils";

// Meritly landing page (`/`): what the app does and the way in. Signed-in visitors get a link to the
// dashboard instead of the sign-in / sign-up calls to action.
const t = getMessages(Astro.locals.locale);
const signedIn = Boolean(Astro.locals.user);
const steps = [t.landing.steps.pool, t.landing.steps.share, t.landing.steps.approval];
const primaryCta = cn(buttonVariants({ size: "lg" }));
const secondaryCta = cn(buttonVariants({ variant: "outline", size: "lg" }));
---

<div class="bg-cosmic text-foreground min-h-screen w-full p-4 sm:p-8">
  <div class="mx-auto w-full max-w-4xl">
    <Topbar />

    <section class="flex flex-col items-center px-4 py-16 text-center sm:py-24">
      <h1 class="text-primary mb-4 text-5xl leading-tight font-bold sm:text-6xl">{t.common.appName}</h1>
      <p class="text-muted-foreground mb-10 max-w-2xl text-lg sm:text-xl">{t.landing.pitch}</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        {signedIn ? (
          <a href="/dashboard" class:list={primaryCta}>
            {t.landing.goToDashboard}
          </a>
        ) : (
          <>
            <a href="/auth/signin" class:list={primaryCta}>
              {t.common.signIn}
            </a>
            <a href="/auth/signup" class:list={secondaryCta}>
              {t.common.signUp}
            </a>
          </>
        )}
      </div>
    </section>

    <section aria-labelledby="how-it-works" class="pb-24">
      <h2 id="how-it-works" class="text-foreground mb-6 text-center text-2xl font-semibold">
        {t.landing.howItWorks}
      </h2>
      <ol class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {steps.map((step, index) => (
          <li class="border-border bg-card text-card-foreground rounded-xl border p-6 backdrop-blur-xl">
            <span aria-hidden="true" class="text-primary mb-2 block text-sm font-semibold">
              {index + 1}
            </span>
            <h3 class="mb-2 text-lg font-semibold">{step.title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{step.body}</p>
          </li>
        ))}
      </ol>
    </section>
  </div>
</div>
