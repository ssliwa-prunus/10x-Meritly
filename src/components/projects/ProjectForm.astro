---
import { SubmitButton } from "@/components/SubmitButton";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { NativeSelect } from "@/components/ui/native-select";
import { Textarea } from "@/components/ui/textarea";
import { WORK_STATUSES } from "@/lib/services/projects";
import type { Profile, Project } from "@/types";

interface Props {
  /** The project to edit; omitted for the create form. */
  project?: Project;
  /** Owner choices. Given only to Admins; without it the owner select is not rendered. */
  supervisors?: Profile[];
  saved: boolean;
  error: string | null;
}

const { project, supervisors, saved, error } = Astro.props;

const sectionId = project ? "project" : "new";
const headingId = `${sectionId}-heading`;
const fieldId = (field: string) => `${sectionId}-${field}`;
const action = project ? `/api/projects/${project.id}` : "/api/projects";
const currentStatus = project?.status ?? "planned";
---

<section id={sectionId} aria-labelledby={headingId}>
  <Card>
    <CardHeader>
      <h2 id={headingId} class="text-xl leading-none font-semibold">
        {project ? "Project details" : "New project"}
      </h2>
      <CardDescription>
        Amounts in PLN, above 0 with at most 2 decimals. The end date must be on or after the start date.
      </CardDescription>
    </CardHeader>

    <CardContent className="flex flex-col gap-4">
      {saved && (
        <Alert variant="success" role="status">
          <AlertDescription>Project saved.</AlertDescription>
        </Alert>
      )}
      {error && (
        <Alert variant="destructive">
          <AlertDescription>{error}</AlertDescription>
        </Alert>
      )}

      <form method="POST" action={action} class="flex flex-col gap-4">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div class="flex flex-col gap-2 sm:col-span-2">
            <Label htmlFor={fieldId("name")}>Name</Label>
            <Input id={fieldId("name")} type="text" name="name" defaultValue={project?.name} maxLength={100} required />
          </div>
          <div class="flex flex-col gap-2">
            <Label htmlFor={fieldId("start-date")}>Start date</Label>
            <Input
              id={fieldId("start-date")}
              type="date"
              name="start_date"
              defaultValue={project?.start_date}
              required
            />
          </div>
          <div class="flex flex-col gap-2">
            <Label htmlFor={fieldId("end-date")}>End date</Label>
            <Input id={fieldId("end-date")} type="date" name="end_date" defaultValue={project?.end_date} required />
          </div>
          <div class="flex flex-col gap-2 [&>[data-slot=native-select-wrapper]]:w-full">
            <Label htmlFor={fieldId("status")}>Status</Label>
            <NativeSelect id={fieldId("status")} name="status" required>
              {WORK_STATUSES.map((status) => (
                <option value={status} selected={status === currentStatus}>
                  {status}
                </option>
              ))}
            </NativeSelect>
          </div>
          <div class="flex flex-col gap-2">
            <Label htmlFor={fieldId("total-budget")}>Total budget (PLN)</Label>
            <Input
              id={fieldId("total-budget")}
              type="text"
              inputMode="decimal"
              name="total_budget"
              defaultValue={project?.total_budget.toFixed(2)}
              autoComplete="off"
              required
            />
          </div>
          {supervisors && (
            <div class="flex flex-col gap-2 sm:col-span-2 [&>[data-slot=native-select-wrapper]]:w-full">
              <Label htmlFor={fieldId("owner")}>Owner</Label>
              <NativeSelect id={fieldId("owner")} name="supervisor_id" required>
                {!project && (
                  <option value="" selected>
                    Choose a supervisor
                  </option>
                )}
                {supervisors.map((supervisor) => (
                  <option value={supervisor.id} selected={supervisor.id === project?.supervisor_id}>
                    {supervisor.display_name ? `${supervisor.display_name} (${supervisor.email})` : supervisor.email}
                  </option>
                ))}
              </NativeSelect>
            </div>
          )}
          <div class="flex flex-col gap-2 sm:col-span-2">
            <Label htmlFor={fieldId("notes")}>Notes</Label>
            <Textarea
              id={fieldId("notes")}
              name="notes"
              maxLength={2000}
              rows={3}
              defaultValue={project?.notes ?? ""}
            />
          </div>
        </div>
        <div>
          <SubmitButton client:load pendingText={project ? "Saving…" : "Creating…"}>
            {project ? "Save project" : "Create project"}
          </SubmitButton>
        </div>
      </form>
    </CardContent>
  </Card>
</section>
