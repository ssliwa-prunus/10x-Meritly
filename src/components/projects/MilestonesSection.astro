---
import MilestoneForm from "@/components/projects/MilestoneForm.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { formatPln } from "@/lib/format";
import { cn } from "@/lib/utils";
import type { Milestone, Project } from "@/types";

interface Props {
  project: Project;
  milestones: Milestone[];
  isAdmin: boolean;
  canEditMilestones: boolean;
  saved: boolean;
  /** Error shown at the top of the section (not tied to a row or the add form). */
  sectionError: string | null;
  /** The milestone whose edit row opens with `rowError`. */
  rowErrorId: string | null;
  rowError: string | null;
  /** Error shown on the add form. */
  addFormError: string | null;
}

const { project, milestones, isAdmin, canEditMilestones, saved, sectionError, rowErrorId, rowError, addFormError } =
  Astro.props;

const isClosed = project.status === "completed" || project.status === "cancelled";
// Approved milestones are frozen: no edit row (MilestoneForm has no 'approved' option, so a submit
// would send another status and hit MR015). A row error for one, e.g. from a replayed form, shows
// at the top of the section instead.
const isEditable = (milestone: Milestone) => canEditMilestones && milestone.status !== "approved";
const orphanRowError =
  rowError !== null && milestones.some((milestone) => milestone.id === rowErrorId && !isEditable(milestone))
    ? rowError
    : null;
const focusRing = "rounded-sm focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50";
---

<section id="milestones" aria-labelledby="milestones-heading">
  <Card>
    <CardHeader>
      <h2 id="milestones-heading" class="text-xl leading-none font-semibold">
        Milestones
      </h2>
      <CardDescription>
        Each milestone's period must lie within the project's ({project.start_date} – {project.end_date}). Cancelled
        milestones are not reserved in the budget; approved ones reserve their actual payout pool.
      </CardDescription>
    </CardHeader>

    <CardContent className="flex flex-col gap-4">
      {saved && (
        <Alert variant="success" role="status">
          <AlertDescription>Milestones saved.</AlertDescription>
        </Alert>
      )}
      {(sectionError ?? orphanRowError) && (
        <Alert variant="destructive">
          <AlertDescription>{sectionError ?? orphanRowError}</AlertDescription>
        </Alert>
      )}
      {isAdmin ? (
        <p class="bg-muted text-muted-foreground rounded-lg px-3 py-2 text-sm">
          Admins can view milestones but not change them.
        </p>
      ) : (
        isClosed && (
          <p class="bg-muted text-muted-foreground rounded-lg px-3 py-2 text-sm">
            This project is {project.status}. Reopen the project (set it to planned or active) before adding or changing
            its milestones.
          </p>
        )
      )}

      {milestones.length === 0 ? (
        <p class="text-muted-foreground text-sm">
          No milestones yet.{canEditMilestones && " Add the first one below."}
        </p>
      ) : (
        <Table className="text-left">
          <TableHeader>
            <TableRow className="hover:bg-transparent">
              <TableHead scope="col" className="text-muted-foreground">
                Name
              </TableHead>
              <TableHead scope="col" className="text-muted-foreground">
                Period
              </TableHead>
              <TableHead scope="col" className="text-muted-foreground">
                Status
              </TableHead>
              <TableHead scope="col" className="text-muted-foreground text-right">
                Target pool
              </TableHead>
            </TableRow>
          </TableHeader>
          {milestones.map((milestone) => (
            <TableBody className="border-b">
              <TableRow
                className={cn(
                  "border-0 align-top hover:bg-transparent",
                  (milestone.status === "cancelled" || milestone.status === "approved") && "text-muted-foreground",
                )}
              >
                <TableCell className="align-top break-words whitespace-normal">
                  <a
                    href={`/projects/${project.id}/milestones/${milestone.id}`}
                    class:list={cn("text-primary hover:underline", focusRing)}
                  >
                    {milestone.name}
                  </a>
                </TableCell>
                <TableCell className="align-top whitespace-normal">
                  <span class="whitespace-nowrap">{milestone.start_date}</span> –{" "}
                  <span class="whitespace-nowrap">{milestone.end_date}</span>
                </TableCell>
                <TableCell className="align-top capitalize">
                  {milestone.status === "approved" ? (
                    <Badge className="bg-success text-success-foreground">Approved</Badge>
                  ) : (
                    milestone.status
                  )}
                </TableCell>
                <TableCell className="text-right align-top tabular-nums">{formatPln(milestone.target_pool)}</TableCell>
              </TableRow>
              {milestone.notes && (
                <TableRow className="border-0 hover:bg-transparent">
                  <TableCell colSpan={4} className="text-muted-foreground pt-0 text-xs whitespace-pre-line">
                    {milestone.notes}
                  </TableCell>
                </TableRow>
              )}
              {isEditable(milestone) && (
                <TableRow className="border-0 hover:bg-transparent">
                  <TableCell colSpan={4} className="pt-0 pb-3 whitespace-normal">
                    <details open={rowErrorId === milestone.id} class="bg-muted rounded-xl border p-3">
                      <summary class:list={cn("text-primary cursor-pointer text-sm hover:underline", focusRing)}>
                        Edit {milestone.name}
                      </summary>
                      <div class="mt-3">
                        <MilestoneForm
                          projectId={project.id}
                          milestone={milestone}
                          error={rowErrorId === milestone.id ? rowError : null}
                        />
                      </div>
                    </details>
                  </TableCell>
                </TableRow>
              )}
            </TableBody>
          ))}
        </Table>
      )}

      {canEditMilestones && (
        <div class="mt-2 border-t pt-5">
          <h3 class="text-muted-foreground mb-2 text-sm font-medium tracking-wide uppercase">Add milestone</h3>
          <MilestoneForm projectId={project.id} error={addFormError} />
        </div>
      )}
    </CardContent>
  </Card>
</section>
