---
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { formatPln } from "@/lib/format";
import { getMessages } from "@/lib/i18n";
import type { ProjectExposure } from "@/types";

interface Props {
  /** null when the exposure row could not be read for this project. */
  exposure: ProjectExposure | null;
}

const { exposure } = Astro.props;
const messages = getMessages(Astro.locals.locale).projects;
const t = messages.exposure;

// `key` drives styling (over budget marks every figure except the budget itself red); the label is display text only.
const figures = exposure
  ? [
      { key: "budget", label: t.budget, value: exposure.total_budget },
      { key: "reserved", label: t.reserved, value: exposure.reserved_total },
      { key: "remaining", label: t.remaining, value: exposure.remaining },
    ]
  : [];
---

<section id="exposure" aria-labelledby="exposure-heading">
  <Card>
    <CardHeader>
      <div class="flex flex-wrap items-center gap-2">
        <h2 id="exposure-heading" class="text-xl leading-none font-semibold">
          {t.heading}
        </h2>
        {exposure?.over_budget && <Badge variant="destructive">{messages.overBudget}</Badge>}
      </div>
      <CardDescription>{t.description}</CardDescription>
    </CardHeader>

    <CardContent>
      {exposure ? (
        <dl class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          {figures.map((figure) => (
            <div class="bg-muted rounded-xl border p-3">
              <dt class="text-muted-foreground text-sm">{figure.label}</dt>
              <dd
                class:list={cn(
                  "mt-1 text-lg font-semibold tabular-nums",
                  exposure.over_budget && figure.key !== "budget" && "text-destructive",
                )}
              >
                {formatPln(figure.value)}
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <Alert variant="destructive">
          <AlertDescription>{t.unavailable}</AlertDescription>
        </Alert>
      )}
    </CardContent>
  </Card>
</section>
