---
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { formatPln } from "@/lib/format";
import type { ProjectExposure } from "@/types";

interface Props {
  /** null when the exposure row could not be read for this project. */
  exposure: ProjectExposure | null;
  multiplierMax: number;
}

const { exposure, multiplierMax } = Astro.props;

const figures = exposure
  ? [
      { label: "Budget", value: exposure.total_budget },
      { label: "Reserved (worst case)", value: exposure.reserved_total },
      { label: "Remaining", value: exposure.remaining },
    ]
  : [];
---

<section id="exposure" aria-labelledby="exposure-heading">
  <Card>
    <CardHeader>
      <div class="flex flex-wrap items-center gap-2">
        <h2 id="exposure-heading" class="text-xl leading-none font-semibold">
          Budget exposure
        </h2>
        {exposure?.over_budget && <Badge variant="destructive">Over budget</Badge>}
      </div>
      <CardDescription>
        Worst case: non-cancelled milestones × maximum multiplier {multiplierMax.toFixed(2)}. Informational only;
        nothing is blocked.
      </CardDescription>
    </CardHeader>

    <CardContent>
      {exposure ? (
        <dl class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          {figures.map((figure) => (
            <div class="bg-muted rounded-xl border p-3">
              <dt class="text-muted-foreground text-sm">{figure.label}</dt>
              <dd
                class:list={cn(
                  "mt-1 text-lg font-semibold tabular-nums",
                  exposure.over_budget && figure.label !== "Budget" && "text-destructive",
                )}
              >
                {formatPln(figure.value)}
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <Alert variant="destructive">
          <AlertDescription>Budget exposure is not available for this project.</AlertDescription>
        </Alert>
      )}
    </CardContent>
  </Card>
</section>
