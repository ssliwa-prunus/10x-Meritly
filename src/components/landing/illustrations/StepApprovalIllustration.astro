  <rect
    x="46"
    y="24"
    width="80"
    height="102"
    rx="10"
    fill="var(--illustration-periwinkle)"
    stroke="var(--illustration-outline)"
    stroke-width="3"
  ></rect>
  <rect
    x="54"
    y="34"
    width="64"
    height="84"
    rx="4"
    fill="var(--illustration-highlight)"
    stroke="var(--illustration-outline)"
    stroke-width="2.5"
  ></rect>
  <rect
    x="70"
    y="16"
    width="32"
    height="16"
    rx="5"
    fill="var(--illustration-navy)"
    stroke="var(--illustration-outline)"
