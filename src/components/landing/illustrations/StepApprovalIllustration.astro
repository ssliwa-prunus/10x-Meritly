  <path d="M186 86Q186 92 192 92Q186 92 186 98Q186 92 180 92Q186 92 186 86Z" fill="var(--primary)"></path>
  <path d="M30 40Q30 46 36 46Q30 46 30 52Q30 46 24 46Q30 46 30 40Z" fill="var(--illustration-gold)"></path>
</svg>
