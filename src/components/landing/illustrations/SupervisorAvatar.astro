---
import { cn } from "@/lib/utils";

// Role card avatar for the Supervisor (glasses, approved sheet, bar chart); decorative.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 120 120" width="96" height="96" aria-hidden="true" class:list={cn(className)}>
  <circle cx="60" cy="60" r="56" fill="var(--primary)" fill-opacity="0.14"></circle>
  <circle
    cx="60"
    cy="27"
    r="9"
    fill="var(--illustration-hair-2)"
    stroke="var(--illustration-outline)"
    stroke-width="3"
  ></circle>
  <rect
    x="52"
    y="72"
    width="16"
    height="16"
    rx="4"
    fill="var(--illustration-skin-2)"
    stroke="var(--illustration-outline)"
    stroke-width="3"
  ></rect>
  <path
    d="M20 120Q20 86 60 86Q100 86 100 120Z"
    fill="var(--primary)"
    stroke="var(--illustration-outline)"
    stroke-width="3"
    stroke-linejoin="round"
  ></path>
  <circle
    cx="60"
    cy="54"
    r="22"
    fill="var(--illustration-skin-2)"
    stroke="var(--illustration-outline)"
    stroke-width="3"
  ></circle>
  <path
    d="M38 54Q36 30 60 31Q84 30 82 54Q80 44 70 41Q60 46 46 42Q40 46 38 54Z"
    fill="var(--illustration-hair-2)"
    stroke="var(--illustration-outline)"
    stroke-width="3"
    stroke-linejoin="round"
  ></path>
  <circle cx="52" cy="56" r="2.4" fill="var(--illustration-outline)"></circle>
  <circle cx="68" cy="56" r="2.4" fill="var(--illustration-outline)"></circle>
  <circle
    cx="52"
    cy="56"
    r="7"
    fill="var(--illustration-highlight)"
    fill-opacity="0.25"
    stroke="var(--illustration-outline)"
    stroke-width="2.5"
  ></circle>
  <circle
    cx="68"
    cy="56"
    r="7"
    fill="var(--illustration-highlight)"
    fill-opacity="0.25"
    stroke="var(--illustration-outline)"
    stroke-width="2.5"
  ></circle>
  <path d="M59 56h2" stroke="var(--illustration-outline)" stroke-width="2.5"></path>
  <path
    d="M53 66q7 5 14 0"
    fill="none"
    stroke="var(--illustration-outline)"
    stroke-width="2.5"
    stroke-linecap="round"
  ></path>
  <g transform="rotate(10 86 100)">
    <rect
      x="74"
      y="86"
      width="26"
      height="32"
      rx="3"
      fill="var(--illustration-highlight)"
      stroke="var(--illustration-outline)"
      stroke-width="2.5"
    ></rect>
    <path
      d="M80 101l4 4l9-9"
      fill="none"
      stroke="var(--success)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </g>
  <rect
    x="88"
    y="28"
    width="6"
    height="14"
    fill="var(--illustration-teal)"
    stroke="var(--illustration-outline)"
    stroke-width="2"
  ></rect>
  <rect
    x="96"
    y="20"
    width="6"
    height="22"
    fill="var(--illustration-peach)"
    stroke="var(--illustration-outline)"
    stroke-width="2"
  ></rect>
  <rect
    x="104"
    y="12"
    width="6"
    height="30"
    fill="var(--illustration-periwinkle)"
    stroke="var(--illustration-outline)"
    stroke-width="2"
  ></rect>
</svg>
