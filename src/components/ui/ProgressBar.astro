---
import { cn } from "@/lib/utils";

// A thin horizontal bar for a 0–100 percentage (budget reserved, project exposure). Out-of-range or
// non-finite values are clamped, so an over-budget project renders a full bar rather than overflowing.
interface Props {
  value: number;
  tone?: "primary" | "destructive";
  /** Accessible name of the bar. */
  label: string;
  class?: string;
}

const { value, tone = "primary", label, class: className } = Astro.props;
const percent = Number.isFinite(value) ? Math.min(100, Math.max(0, value)) : 0;
---

<div
  role="progressbar"
  aria-label={label}
  aria-valuemin={0}
  aria-valuemax={100}
  aria-valuenow={percent}
  class:list={cn("bg-muted h-2 w-full overflow-hidden rounded-full", className)}
>
  <div
    class:list={cn("h-full rounded-full", tone === "destructive" ? "bg-destructive" : "bg-primary")}
    style={`width: ${percent}%`}
  ></div>
</div>
