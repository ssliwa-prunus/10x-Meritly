---
import { SubmitButton } from "@/components/SubmitButton";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { Label } from "@/components/ui/label";
import { formatDate } from "@/lib/format";
import { cn } from "@/lib/utils";
import type { MilestoneStatus } from "@/types";

interface Props {
  projectId: string;
  milestoneId: string;
  status: MilestoneStatus;
  /** True when the caller is the owning Supervisor and every approval precondition holds. */
  canApprove: boolean;
  /** Why the milestone cannot be approved (unscored, no engagements, cancelled, project closed, Admin). */
  blockedReason: string | null;
  /** approved_at of the snapshot; null until approved. */
  approvedAt: string | null;
  /** Approved lines whose bonus email the provider confirmed, and all approved lines; null until approved. */
  notifiedCount: number | null;
  lineCount: number | null;
  /** True when the viewer may re-send unsent emails (the owning Supervisor, not an Admin). */
  canNotify: boolean;
  /** Success flash: approved, or unsent emails re-sent. */
  saved: "approved" | "notified" | null;
  /** Catalog text when not every bonus email went out. */
  notice: string | null;
  error: string | null;
}

const {
  projectId,
  milestoneId,
  status,
  canApprove,
  blockedReason,
  approvedAt,
  notifiedCount,
  lineCount,
  canNotify,
  saved,
  notice,
  error,
} = Astro.props;

const isApproved = status === "approved";
const action = `/api/projects/${projectId}/milestones/${milestoneId}/approve`;
const notifyAction = `/api/projects/${projectId}/milestones/${milestoneId}/notify`;
const hasEmailCounts = isApproved && notifiedCount !== null && lineCount !== null;
const canResend = hasEmailCounts && canNotify && notifiedCount < lineCount;
const focusRing = "focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50";
---

<section id="approval" aria-labelledby="approval-heading">
  <Card>
    <CardHeader>
      <div class="flex flex-wrap items-center gap-2">
        <h2 id="approval-heading" class="text-xl leading-none font-semibold">
          Approval
        </h2>
        {isApproved && <Badge className="bg-success text-success-foreground">Approved</Badge>}
      </div>
      <CardDescription>
        Approval is final: the computed bonuses are frozen, and only then does each employee see their own bonus.
      </CardDescription>
    </CardHeader>

    <CardContent className="flex flex-col gap-4">
      {saved && (
        <Alert variant="success" role="status">
          <AlertDescription>{saved === "approved" ? "Milestone approved." : "Unsent emails re-sent."}</AlertDescription>
        </Alert>
      )}
      {notice && (
        <Alert variant="destructive">
          <AlertDescription>{notice}</AlertDescription>
        </Alert>
      )}
      {error && (
        <Alert variant="destructive">
          <AlertDescription>{error}</AlertDescription>
        </Alert>
      )}

      {isApproved ? (
        <>
          <p class="text-sm">
            {approvedAt ? `Approved on ${formatDate(approvedAt)}.` : "Approved."} The figures are frozen and each
            employee sees their own bonus.
          </p>
          {hasEmailCounts && (
            <p class="text-sm">
              Emails sent:{" "}
              <span class="tabular-nums">
                {notifiedCount} of {lineCount}
              </span>
            </p>
          )}
          {canResend && (
            <form method="POST" action={notifyAction}>
              <SubmitButton client:load variant="outline" pendingText="Sending…">
                Re-send unsent emails
              </SubmitButton>
            </form>
          )}
        </>
      ) : canApprove ? (
        <form method="POST" action={action} class="flex flex-col gap-4">
          <div class="flex items-start gap-2">
            <input
              id="approval-confirm"
              type="checkbox"
              name="confirm"
              value="on"
              required
              class:list={cn("accent-primary mt-0.5 size-4 shrink-0 rounded-sm", focusRing)}
            />
            <Label htmlFor="approval-confirm" className="leading-snug font-normal">
              I understand this is final; figures are frozen and employees are notified
            </Label>
          </div>
          <div>
            <SubmitButton client:load pendingText="Approving…">
              Approve milestone
            </SubmitButton>
          </div>
        </form>
      ) : (
        blockedReason && <p class="bg-muted text-muted-foreground rounded-lg px-3 py-2 text-sm">{blockedReason}</p>
      )}
    </CardContent>
  </Card>
</section>
