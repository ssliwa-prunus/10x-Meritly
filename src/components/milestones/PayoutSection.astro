---
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { formatDate, formatMultiplier, formatPercent, formatPln, formatShare } from "@/lib/format";
import { format, getMessages } from "@/lib/i18n";
import { cn } from "@/lib/utils";
import type { MilestonePayoutLine, MilestonePayoutSummary } from "@/types";

interface Props {
  summary: MilestonePayoutSummary;
  lines: MilestonePayoutLine[];
  /** approved_at of the frozen snapshot; set when the figures come from an approved milestone. */
  approvedAt?: string | null;
}

const { summary, lines, approvedAt = null } = Astro.props;

// Amounts arrive already computed and floored in SQL; this view only formats them. A null figure
// needs all four KPI scores: it renders the "unscored" hint, styled by the null check, not the text.
const t = getMessages(Astro.locals.locale);
const f = t.common.fields;
const labels = t.milestones.payout;
const unscored = t.milestones.unscored;
const money = (value: number | null) => (value === null ? null : formatPln(value));

const figures: { label: string; value: string | null }[] = [
  { label: labels.figures.targetPoolMax, value: formatPln(summary.target_pool) },
  {
    label: labels.figures.kpiMultiplier,
    value: summary.multiplier === null ? null : formatMultiplier(summary.multiplier),
  },
  {
    label: labels.figures.shareOfTargetPool,
    value: summary.budget_share === null ? null : formatShare(summary.budget_share),
  },
  { label: labels.figures.payoutPool, value: money(summary.payout_pool) },
  { label: labels.figures.payoutTotal, value: money(summary.payout_total) },
  { label: labels.figures.residual, value: money(summary.residual) },
];

const focusRing = "rounded-sm focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50";
---

<section id="bonuses" aria-labelledby="bonuses-heading">
  <Card>
    <CardHeader>
      <div class="flex flex-wrap items-center gap-2">
        <h2 id="bonuses-heading" class="text-xl leading-none font-semibold">
          {labels.heading}
        </h2>
        {approvedAt !== null ? (
          <Badge className="bg-success text-success-foreground">{t.status.milestone.approved}</Badge>
        ) : (
          <>
            {summary.within_pool === true && (
              <Badge className="bg-success text-success-foreground">{labels.withinPool}</Badge>
            )}
            {summary.within_pool === false && <Badge variant="destructive">{labels.exceedsPool}</Badge>}
          </>
        )}
      </div>
      <CardDescription>
        {approvedAt !== null ? format(labels.approvedOn, { date: formatDate(approvedAt) }) : labels.draft}{" "}
        {labels.formula}
      </CardDescription>
    </CardHeader>

    <CardContent className="flex flex-col gap-4">
      <dl class="grid grid-cols-1 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {figures.map((figure) => (
          <div class="bg-muted rounded-xl border p-3">
            <dt class="text-muted-foreground text-sm">{figure.label}</dt>
            <dd
              class:list={cn(
                "mt-1 font-semibold tabular-nums",
                figure.value === null ? "text-muted-foreground text-sm" : "text-lg",
              )}
            >
              {figure.value ?? unscored}
            </dd>
          </div>
        ))}
      </dl>

      {lines.length === 0 ? (
        <p class="text-muted-foreground text-sm">
          {labels.noLinesBefore}
          {/* The link and the text after it must touch: a line break between them renders as a space. */}
          <!-- prettier-ignore -->
          <span><a href="#assignments" class:list={cn("text-primary hover:underline", focusRing)}>{labels.noLinesLink}</a>{labels.noLinesAfter}</span>
        </p>
      ) : (
        <Table className="min-w-3xl text-left">
          <TableHeader>
            <TableRow className="hover:bg-transparent">
              <TableHead scope="col" className="text-muted-foreground">
                {f.employee}
              </TableHead>
              <TableHead scope="col" className="text-muted-foreground">
                {f.jobRole}
              </TableHead>
              <TableHead scope="col" className="text-muted-foreground text-right">
                {f.timeShare}
              </TableHead>
              <TableHead scope="col" className="text-muted-foreground text-right">
                {f.roleWeight}
              </TableHead>
              <TableHead scope="col" className="text-muted-foreground text-right">
                {f.ratingFactor}
              </TableHead>
              <TableHead scope="col" className="text-muted-foreground text-right">
                {labels.weightedContribution}
              </TableHead>
              <TableHead scope="col" className="text-muted-foreground text-right">
                {labels.share}
              </TableHead>
              <TableHead scope="col" className="text-muted-foreground text-right">
                {f.bonus}
              </TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {lines.map((line) => (
              <TableRow className="align-top hover:bg-transparent">
                <TableCell className="align-top break-words whitespace-normal">
                  <a href={`/employees/${line.employee_id}`} class:list={cn("text-primary hover:underline", focusRing)}>
                    {line.employee_name}
                  </a>
                </TableCell>
                <TableCell className="align-top whitespace-normal">{line.job_role_name}</TableCell>
                <TableCell className="text-right align-top tabular-nums">{formatPercent(line.time_share)}</TableCell>
                <TableCell className="text-right align-top tabular-nums">
                  {formatMultiplier(line.role_weight)}
                </TableCell>
                <TableCell className="text-right align-top tabular-nums">
                  {line.rating} → {formatMultiplier(line.rating_factor)}
                </TableCell>
                <TableCell className="text-right align-top tabular-nums">
                  {formatMultiplier(line.weighted_contribution)}
                </TableCell>
                <TableCell className="text-right align-top tabular-nums">{formatShare(line.share)}</TableCell>
                <TableCell
                  className={cn(
                    "text-right align-top tabular-nums",
                    line.bonus === null ? "text-muted-foreground" : "font-semibold",
                  )}
                >
                  {money(line.bonus) ?? unscored}
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      )}
    </CardContent>
  </Card>
</section>
