---
import { SubmitButton } from "@/components/SubmitButton";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { NativeSelect } from "@/components/ui/native-select";
import type { AssignableEmployee, Engagement } from "@/types";

interface Props {
  projectId: string;
  milestoneId: string;
  /** The assignment to edit; omitted for the add form. */
  engagement?: Engagement;
  /** Employee choices for the add form: the Supervisor's own employees not yet on this milestone. */
  employees?: AssignableEmployee[];
  error: string | null;
}

const { projectId, milestoneId, engagement, employees = [], error } = Astro.props;

const basePath = `/api/projects/${projectId}/milestones/${milestoneId}/engagements`;
const action = engagement ? `${basePath}/${engagement.id}` : basePath;
const currentRating = engagement?.rating ?? 3;
// Several EngagementForms render on one page, so every field id carries the form instance.
const fieldId = (field: string) => `engagement-${engagement?.id ?? "new"}-${field}`;
---

<div class="flex flex-col gap-3">
  {error && (
    <Alert variant="destructive">
      <AlertDescription>{error}</AlertDescription>
    </Alert>
  )}
  <form method="POST" action={action} class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    {!engagement && (
      <div class="flex flex-col gap-2 [&>[data-slot=native-select-wrapper]]:w-full">
        <Label htmlFor={fieldId("employee")}>Employee</Label>
        <NativeSelect id={fieldId("employee")} name="employee_id" required>
          <option value="" selected>
            Choose an employee
          </option>
          {employees.map((employee) => (
            <option value={employee.id}>{employee.full_name}</option>
          ))}
        </NativeSelect>
      </div>
    )}
    <div class="flex flex-col gap-2">
      <Label htmlFor={fieldId("time-share")}>Time share (0.01–1.00)</Label>
      <Input
        id={fieldId("time-share")}
        type="text"
        inputMode="decimal"
        name="time_share"
        defaultValue={engagement?.time_share.toFixed(2)}
        placeholder="0.50"
        autoComplete="off"
        required
      />
    </div>
    <div class="flex flex-col gap-2 [&>[data-slot=native-select-wrapper]]:w-full">
      <Label htmlFor={fieldId("rating")}>Rating (1–5)</Label>
      <NativeSelect id={fieldId("rating")} name="rating" required>
        {[1, 2, 3, 4, 5].map((rating) => (
          <option value={String(rating)} selected={rating === currentRating}>
            {rating}
          </option>
        ))}
      </NativeSelect>
    </div>
    <div class="sm:col-span-3">
      {/* Edit forms sit inside a closed <details>; hydrate when the row is opened. */}
      {engagement ? (
        <SubmitButton client:visible pendingText="Saving…">
          Save assignment
        </SubmitButton>
      ) : (
        <SubmitButton client:load pendingText="Assigning…">
          Assign employee
        </SubmitButton>
      )}
    </div>
  </form>
</div>
