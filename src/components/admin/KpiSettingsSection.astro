---
import { getMessages } from "@/lib/i18n";
import type { BonusSettings } from "@/types";
import { buttonClass, inputClass } from "@/components/form-classes";

interface Props {
  settings: BonusSettings;
  saved: boolean;
  error: string | null;
}

const { settings, saved, error } = Astro.props;
const labels = getMessages(Astro.locals.locale).admin.kpi;

// The KPI names are product terms and stay the same in every language.
const weights = [
  { name: "kpi_weight_schedule", label: "Termin", value: settings.kpi_weight_schedule },
  { name: "kpi_weight_budget", label: "Budżet", value: settings.kpi_weight_budget },
  { name: "kpi_weight_quality", label: "Jakość", value: settings.kpi_weight_quality },
  { name: "kpi_weight_risk", label: "Ryzyko", value: settings.kpi_weight_risk },
];

const bounds = [
  { name: "multiplier_min", label: labels.minMultiplier, value: settings.multiplier_min },
  { name: "multiplier_max", label: labels.maxMultiplier, value: settings.multiplier_max },
];
---

<section
  id="kpi"
  aria-labelledby="kpi-heading"
  class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl sm:p-6"
>
  <h2 id="kpi-heading" class="text-xl font-semibold">
    {labels.heading}
  </h2>
  <p class="mt-1 text-sm text-blue-100/60">{labels.description}</p>

  {saved && (
    <p role="status" class="mt-3 rounded-lg bg-emerald-500/15 px-3 py-2 text-sm text-emerald-100">
      {labels.saved}
    </p>
  )}
  {error && (
    <p role="alert" class="mt-3 rounded-lg bg-red-500/15 px-3 py-2 text-sm text-red-100">
      {error}
    </p>
  )}

  <form method="POST" action="/api/admin/bonus-settings/kpi" class="mt-4 flex flex-col gap-4">
    <fieldset class="min-w-0">
      <legend class="mb-2 text-sm font-medium text-blue-100/80">{labels.weightsLegend}</legend>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-4">
        {weights.map((field) => (
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-blue-100/80">{field.label}</span>
            <input
              type="number"
              name={field.name}
              value={field.value.toFixed(2)}
              min="0"
              max="1"
              step="0.01"
              required
              class:list={inputClass}
            />
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="min-w-0">
      <legend class="mb-2 text-sm font-medium text-blue-100/80">{labels.boundsLegend}</legend>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {bounds.map((field) => (
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-blue-100/80">{field.label}</span>
            <input
              type="number"
              name={field.name}
              value={field.value.toFixed(2)}
              min="0.01"
              max="3"
              step="0.01"
              required
              class:list={inputClass}
            />
          </label>
        ))}
      </div>
    </fieldset>
    <div>
      <button type="submit" class:list={buttonClass}>
        {labels.save}
      </button>
    </div>
  </form>
</section>
