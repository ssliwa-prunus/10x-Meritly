---
import { cn } from "@/lib/utils";
import type { BonusSettings } from "@/types";

interface Props {
  settings: BonusSettings;
  saved: boolean;
  error: string | null;
}

const { settings, saved, error } = Astro.props;

const inputClass = cn(
  "w-full rounded-lg border border-white/20 bg-white/5 px-3 py-2 text-white",
  "focus:border-purple-300 focus:ring-2 focus:ring-purple-300/40 focus:outline-none",
);

const weights = [
  { name: "kpi_weight_schedule", label: "Termin", value: settings.kpi_weight_schedule },
  { name: "kpi_weight_budget", label: "Budżet", value: settings.kpi_weight_budget },
  { name: "kpi_weight_quality", label: "Jakość", value: settings.kpi_weight_quality },
  { name: "kpi_weight_risk", label: "Ryzyko", value: settings.kpi_weight_risk },
];

const bounds = [
  { name: "multiplier_min", label: "Minimum multiplier", value: settings.multiplier_min },
  { name: "multiplier_max", label: "Maximum multiplier", value: settings.multiplier_max },
];
---

<section
  id="kpi"
  aria-labelledby="kpi-heading"
  class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl sm:p-6"
>
  <h2 id="kpi-heading" class="text-xl font-semibold">
    Milestone KPI
  </h2>
  <p class="mt-1 text-sm text-blue-100/60">
    KPI weights must sum to 1.00. The milestone multiplier stays between the minimum and maximum bounds.
  </p>

  {saved && (
    <p role="status" class="mt-3 rounded-lg bg-emerald-500/15 px-3 py-2 text-sm text-emerald-100">
      KPI settings saved.
    </p>
  )}
  {error && (
    <p role="alert" class="mt-3 rounded-lg bg-red-500/15 px-3 py-2 text-sm text-red-100">
      {error}
    </p>
  )}

  <form method="POST" action="/api/admin/bonus-settings/kpi" class="mt-4 flex flex-col gap-4">
    <fieldset class="min-w-0">
      <legend class="mb-2 text-sm font-medium text-blue-100/80">KPI weights (must sum to 1.00)</legend>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-4">
        {weights.map((field) => (
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-blue-100/80">{field.label}</span>
            <input
              type="number"
              name={field.name}
              value={field.value.toFixed(2)}
              min="0"
              max="1"
              step="0.01"
              required
              class:list={inputClass}
            />
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="min-w-0">
      <legend class="mb-2 text-sm font-medium text-blue-100/80">
        Milestone multiplier bounds (0 &lt; min &lt; max ≤ 3)
      </legend>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {bounds.map((field) => (
          <label class="flex flex-col gap-1 text-sm">
            <span class="text-blue-100/80">{field.label}</span>
            <input
              type="number"
              name={field.name}
              value={field.value.toFixed(2)}
              min="0.01"
              max="3"
              step="0.01"
              required
              class:list={inputClass}
            />
          </label>
        ))}
      </div>
    </fieldset>
    <div>
      <button
        type="submit"
        class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
      >
        Save KPI settings
      </button>
    </div>
  </form>
</section>
