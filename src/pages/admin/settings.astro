---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import JobRolesSection from "@/components/admin/JobRolesSection.astro";
import KpiSettingsSection from "@/components/admin/KpiSettingsSection.astro";
import RatingFactorsSection from "@/components/admin/RatingFactorsSection.astro";
import { getMessages } from "@/lib/i18n";
import { logContextFrom } from "@/lib/error-log";
import { createClient } from "@/lib/supabase";
import {
  getBonusSettings,
  listJobRoles,
  settingsErrorMessage,
  type SettingsSection,
} from "@/lib/services/bonus-config";

const locale = Astro.locals.locale;
const t = getMessages(locale);

const saved = Astro.url.searchParams.get("saved");
const errorCode = Astro.url.searchParams.get("error");
const errorField = Astro.url.searchParams.get("field");
const section = Astro.url.searchParams.get("section");

// The URL carries only an error code; the displayed text always comes from the fixed catalog.
const statusFor = (name: SettingsSection) => ({
  saved: saved === name,
  error: errorCode && section === name ? settingsErrorMessage(errorCode, errorField, locale) : null,
});

const supabase = createClient(Astro.request.headers, Astro.cookies);
const log = logContextFrom(Astro.locals, Astro.request);

let loadError: string | null;
let rolesResult: Awaited<ReturnType<typeof listJobRoles>> = {};
let settingsResult: Awaited<ReturnType<typeof getBonusSettings>> = {};

if (!supabase) {
  loadError = t.common.supabaseNotConfigured;
} else {
  [rolesResult, settingsResult] = await Promise.all([listJobRoles(supabase, log), getBonusSettings(supabase, log)]);
  loadError =
    rolesResult.error || settingsResult.error === "load_failed"
      ? t.admin.loadFailed
      : settingsResult.error === "settings_missing"
        ? t.admin.settingsMissing
        : null;
}

const roles = rolesResult.data;
const settings = settingsResult.data;
---

<Layout title={t.admin.bonusSettings} languageSwitch={false}>
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto w-full max-w-4xl">
      <Topbar current="admin" />
      <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          {t.admin.bonusSettings}
        </h1>
        <a href="/admin" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          {t.admin.settings.backToAdmin}
        </a>
      </div>
      <p class="mb-6 text-sm text-blue-100/60">{t.admin.settings.intro}</p>

      {loadError || !roles || !settings ? (
        <div role="alert" class="rounded-2xl border border-red-400/40 bg-red-500/15 p-6 text-red-100">
          <p class="font-semibold">{t.admin.settings.loadFailedTitle}</p>
          <p class="mt-1 text-sm text-red-100/80">{loadError ?? t.common.unknownError}</p>
        </div>
      ) : (
        <div class="flex flex-col gap-6">
          <JobRolesSection roles={roles} {...statusFor("roles")} />
          <KpiSettingsSection settings={settings} {...statusFor("kpi")} />
          <RatingFactorsSection settings={settings} {...statusFor("factors")} />
        </div>
      )}
    </div>
  </div>
</Layout>
