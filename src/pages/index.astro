---
import Welcome from "@/components/Welcome.astro";
import Layout from "@/layouts/Layout.astro";

// The landing header renders its own inline language switch, so Layout's fixed one is off here, and only
// this page loads the landing fonts (Space Grotesk, IBM Plex Sans, IBM Plex Mono).
---

<Layout languageSwitch={false}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </Fragment>
  <Welcome />
</Layout>
