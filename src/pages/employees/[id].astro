---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import EmployeeHistory from "@/components/history/EmployeeHistory.astro";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { logContextFrom } from "@/lib/error-log";
import { createClient } from "@/lib/supabase";
import { formatPercent } from "@/lib/format";
import { getMessages } from "@/lib/i18n";
import { groupHistory } from "@/lib/history";
import { cn } from "@/lib/utils";
import { listEmployeeHistory } from "@/lib/services/approvals";
import { employeeIdSchema, getEmployeeDetail, inviteStatus, listOpenAssignments } from "@/lib/services/employees";

// S-06 employee detail. Middleware limits it to Supervisor/Admin; RLS decides what each sees: a
// Supervisor only their own milestones (history and assignments), an Admin everything. Draft
// figures are never shown here; history comes from the frozen approval snapshot.
const isAdmin = Astro.locals.profile?.role === "admin";
const t = getMessages(Astro.locals.locale);
const f = t.common.fields;
const d = t.employees.detail;
const id = employeeIdSchema.safeParse(Astro.params.id);
const supabase = createClient(Astro.request.headers, Astro.cookies);
const log = logContextFrom(Astro.locals, Astro.request);

let loadError: string | null = null;
let detailResult: Awaited<ReturnType<typeof getEmployeeDetail>> = {};
let assignmentsResult: Awaited<ReturnType<typeof listOpenAssignments>> = {};
let historyResult: Awaited<ReturnType<typeof listEmployeeHistory>> = {};

if (!supabase) {
  loadError = t.common.supabaseNotConfigured;
} else if (id.success) {
  [detailResult, assignmentsResult, historyResult] = await Promise.all([
    getEmployeeDetail(supabase, id.data, log),
    listOpenAssignments(supabase, id.data, log),
    listEmployeeHistory(supabase, id.data, log),
  ]);
  loadError =
    detailResult.error || assignmentsResult.error
      ? t.employees.loadFailed
      : historyResult.error
        ? t.history.loadFailed
        : null;
}

// An invalid id, a missing employee and one hidden by RLS all look the same: not found.
const employee = id.success ? (detailResult.data ?? null) : null;
const assignments = assignmentsResult.data ?? [];
const history = groupHistory(historyResult.data ?? []);

const focusRing = "rounded-sm focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50";
---

<Layout title={employee ? employee.full_name : d.fallbackTitle}>
  <div class="bg-cosmic text-foreground min-h-screen p-4">
    <div class="mx-auto w-full max-w-4xl">
      <Topbar />
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="text-foreground min-w-0 text-3xl font-bold break-words">
          {employee ? employee.full_name : d.fallbackTitle}
        </h1>
        <a href="/employees" class:list={cn("text-primary text-sm hover:underline", focusRing)}>
          {d.backToEmployees}
        </a>
      </div>

      {loadError ? (
        <Alert variant="destructive">
          <AlertTitle>{d.loadFailedTitle}</AlertTitle>
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      ) : !employee ? (
        <Card>
          <CardHeader>
            <CardTitle>{d.notFound}</CardTitle>
            <CardDescription>{d.notFoundDescription}</CardDescription>
          </CardHeader>
        </Card>
      ) : (
        <div class="flex flex-col gap-6">
          <Card>
            <CardContent>
              <dl class="grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
                <div>
                  <dt class="text-muted-foreground">{f.email}</dt>
                  <dd class="mt-1 break-all">{employee.email}</dd>
                </div>
                <div>
                  <dt class="text-muted-foreground">{f.jobRole}</dt>
                  <dd class="mt-1">{employee.job_role_name}</dd>
                </div>
                <div>
                  <dt class="text-muted-foreground">{d.account}</dt>
                  <dd class="mt-1">{t.status.invite[inviteStatus(employee)]}</dd>
                </div>
                <div>
                  <dt class="text-muted-foreground">{isAdmin ? f.openTotalAll : f.openTotalOwn}</dt>
                  <dd class="mt-1 flex items-center gap-2 tabular-nums">
                    {formatPercent(employee.open_total)}
                    {employee.over_allocated && <Badge variant="destructive">{t.common.over100}</Badge>}
                  </dd>
                </div>
              </dl>
            </CardContent>
          </Card>

          <section aria-labelledby="assignments-heading">
            <Card>
              <CardHeader>
                <h2 id="assignments-heading" class="text-xl leading-none font-semibold">
                  {d.currentAssignments}
                </h2>
                <CardDescription>{isAdmin ? d.assignmentsDescriptionAll : d.assignmentsDescriptionOwn}</CardDescription>
              </CardHeader>
              <CardContent>
                {assignments.length === 0 ? (
                  <p class="text-muted-foreground text-sm">{d.noOpenAssignments}</p>
                ) : (
                  <Table className="min-w-xl text-left">
                    <TableHeader>
                      <TableRow className="hover:bg-transparent">
                        <TableHead scope="col" className="text-muted-foreground">
                          {f.project}
                        </TableHead>
                        <TableHead scope="col" className="text-muted-foreground">
                          {f.milestone}
                        </TableHead>
                        <TableHead scope="col" className="text-muted-foreground">
                          {f.period}
                        </TableHead>
                        <TableHead scope="col" className="text-muted-foreground text-right">
                          {f.timeShare}
                        </TableHead>
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {assignments.map((assignment) => (
                        <TableRow className="align-top hover:bg-transparent">
                          <TableCell className="align-top break-words whitespace-normal">
                            {assignment.project_name}
                          </TableCell>
                          <TableCell className="align-top break-words whitespace-normal">
                            <a
                              href={`/projects/${assignment.project_id}/milestones/${assignment.milestone_id}`}
                              class:list={cn("text-primary hover:underline", focusRing)}
                            >
                              {assignment.milestone_name}
                            </a>
                          </TableCell>
                          <TableCell className="align-top">
                            <span class="whitespace-nowrap">{assignment.start_date}</span> –{" "}
                            <span class="whitespace-nowrap">{assignment.end_date}</span>
                          </TableCell>
                          <TableCell className="text-right align-top tabular-nums">
                            {formatPercent(assignment.time_share)}
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                )}
              </CardContent>
            </Card>
          </section>

          <section aria-labelledby="history-heading">
            <Card>
              <CardHeader>
                <h2 id="history-heading" class="text-xl leading-none font-semibold">
                  {isAdmin ? d.historyAll : d.historyOwn}
                </h2>
                <CardDescription>{d.historyDescription}</CardDescription>
              </CardHeader>
              <CardContent>
                <EmployeeHistory history={history} emptyText={t.history.empty} />
              </CardContent>
            </Card>
          </section>
        </div>
      )}
    </div>
  </div>
</Layout>
