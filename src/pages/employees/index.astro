---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import EmployeeForm from "@/components/employees/EmployeeForm.astro";
import { buttonClass } from "@/components/form-classes";
import { logContextFrom } from "@/lib/error-log";
import { createClient } from "@/lib/supabase";
import { formatPercent } from "@/lib/format";
import { format, getMessages } from "@/lib/i18n";
import { cn } from "@/lib/utils";
import { listJobRoles } from "@/lib/services/bonus-config";
import { employeesErrorMessage, inviteStatus, listEmployees } from "@/lib/services/employees";
import { listSupervisors } from "@/lib/services/projects";
import type { EmployeeListItem, InviteStatus } from "@/types";

const profile = Astro.locals.profile;
const isAdmin = profile?.role === "admin";
const locale = Astro.locals.locale;
const t = getMessages(locale);
const f = t.common.fields;

const saved = Astro.url.searchParams.get("saved");
const errorCode = Astro.url.searchParams.get("error");
const errorField = Astro.url.searchParams.get("field");
const errorEmployeeId = Astro.url.searchParams.get("employee");

// The URL carries only codes; the displayed text always comes from fixed catalogs.
const errorMessage = errorCode ? employeesErrorMessage(errorCode, errorField, locale) : null;
const savedMessages = t.employees.saved;
const savedMessage =
  saved !== null && Object.hasOwn(savedMessages, saved) ? savedMessages[saved as keyof typeof savedMessages] : null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const log = logContextFrom(Astro.locals, Astro.request);

let loadError: string | null;
let employeesResult: Awaited<ReturnType<typeof listEmployees>> = {};
let jobRolesResult: Awaited<ReturnType<typeof listJobRoles>> = {};
let supervisorsResult: Awaited<ReturnType<typeof listSupervisors>> = {};

if (!supabase || !profile) {
  loadError = supabase ? t.common.profileLoadFailed : t.common.supabaseNotConfigured;
} else {
  [employeesResult, jobRolesResult, supervisorsResult] = await Promise.all([
    // A Supervisor lists only the employees they own, not ones they merely see through an assignment.
    listEmployees(supabase, isAdmin ? {} : { ownerId: profile.id }, log),
    listJobRoles(supabase, log),
    isAdmin ? listSupervisors(supabase, log) : Promise.resolve({}),
  ]);
  const failed = employeesResult.error ?? jobRolesResult.error ?? supervisorsResult.error;
  loadError = failed ? t.employees.loadFailed : null;
}

const employees = employeesResult.data;
const allJobRoles = jobRolesResult.data ?? [];
const activeJobRoles = allJobRoles.filter((role) => role.archived_at === null);
const supervisors = supervisorsResult.data;
const ownerById = new Map((supervisors ?? []).map((owner) => [owner.id, owner.display_name ?? owner.email]));

/** Active roles, plus the employee's current role when it has since been archived, so saving keeps it. */
const jobRolesFor = (employee: EmployeeListItem) =>
  activeJobRoles.some((role) => role.id === employee.job_role_id)
    ? activeJobRoles
    : [...activeJobRoles, ...allJobRoles.filter((role) => role.id === employee.job_role_id)];

// Where an error shows: on the failing row, on the register form, or at the top of the page.
const rowErrorId =
  errorMessage && employees?.some((employee) => employee.id === errorEmployeeId) ? errorEmployeeId : null;
const registerError = errorEmployeeId === null ? errorMessage : null;
const pageError = rowErrorId === null && registerError === null ? errorMessage : null;

const STATUS_CLASSES: Record<InviteStatus, string> = {
  not_invited: "border-white/20 bg-white/10 text-blue-100",
  invited: "border-amber-400/40 bg-amber-500/20 text-amber-100",
  active: "border-emerald-400/40 bg-emerald-500/20 text-emerald-100",
};

const columnCount = isAdmin ? 7 : 6;
const loaded = !loadError && employees && jobRolesResult.data && (!isAdmin || supervisors);
---

<Layout title={t.employees.title} languageSwitch={false}>
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto w-full max-w-5xl">
      <Topbar current="employees" />
      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {t.employees.title}
      </h1>
      <p class="mb-6 text-sm text-blue-100/60">{t.common.openTotalNote}</p>

      {savedMessage && (
        <p role="status" class="mb-6 rounded-lg bg-emerald-500/15 px-3 py-2 text-sm text-emerald-100">
          {savedMessage}
        </p>
      )}
      {pageError && (
        <p role="alert" class="mb-6 rounded-lg bg-red-500/15 px-3 py-2 text-sm text-red-100">
          {pageError}
        </p>
      )}

      {!loaded ? (
        <div role="alert" class="rounded-2xl border border-red-400/40 bg-red-500/15 p-6 text-red-100">
          <p class="font-semibold">{t.employees.listLoadFailedTitle}</p>
          <p class="mt-1 text-sm text-red-100/80">{loadError ?? t.common.unknownError}</p>
        </div>
      ) : (
        <div class="flex flex-col gap-6">
          <section
            id="list"
            aria-labelledby="list-heading"
            class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl sm:p-6"
          >
            <h2 id="list-heading" class="text-xl font-semibold">
              {isAdmin ? t.employees.allEmployees : t.employees.yourEmployees}
            </h2>
            {employees.length === 0 ? (
              <p class="mt-3 text-sm text-blue-100/60">{t.employees.empty}</p>
            ) : (
              <div class="mt-4 overflow-x-auto">
                <table class="w-full min-w-[44rem] text-left text-sm">
                  <thead class="text-blue-100/70">
                    <tr class="border-b border-white/10">
                      <th scope="col" class="py-2 pr-3 font-medium">
                        {t.employees.fullName}
                      </th>
                      <th scope="col" class="py-2 pr-3 font-medium">
                        {f.email}
                      </th>
                      <th scope="col" class="py-2 pr-3 font-medium">
                        {f.jobRole}
                      </th>
                      {isAdmin && (
                        <th scope="col" class="py-2 pr-3 font-medium">
                          {f.owner}
                        </th>
                      )}
                      <th scope="col" class="py-2 pr-3 font-medium">
                        {f.status}
                      </th>
                      <th scope="col" class="py-2 pr-3 text-right font-medium">
                        {isAdmin ? f.openTotalAll : f.openTotalOwn}
                      </th>
                      <th scope="col" class="py-2 font-medium">
                        <span class="sr-only">{t.employees.invite}</span>
                      </th>
                    </tr>
                  </thead>
                  {employees.map((employee) => {
                    const status = inviteStatus(employee);
                    return (
                      <tbody class="border-b border-white/5">
                        <tr class="align-top">
                          <td class="py-2 pr-3 break-words">
                            <a
                              href={`/employees/${employee.id}`}
                              class="rounded-sm text-purple-300 hover:text-purple-100 hover:underline focus-visible:ring-3 focus-visible:ring-purple-300/40 focus-visible:outline-none"
                            >
                              {employee.full_name}
                            </a>
                          </td>
                          <td class="py-2 pr-3 break-all text-blue-100/80">{employee.email}</td>
                          <td class="py-2 pr-3">{employee.job_role_name}</td>
                          {isAdmin && (
                            <td class="py-2 pr-3 text-blue-100/80">{ownerById.get(employee.supervisor_id) ?? "—"}</td>
                          )}
                          <td class="py-2 pr-3">
                            <span
                              class:list={cn(
                                "rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap",
                                STATUS_CLASSES[status],
                              )}
                            >
                              {t.status.invite[status]}
                            </span>
                          </td>
                          <td class="py-2 pr-3 text-right whitespace-nowrap tabular-nums">
                            <span class="inline-flex items-center gap-2">
                              {formatPercent(employee.open_total)}
                              {employee.over_allocated && (
                                <span class="rounded-full border border-red-400/40 bg-red-500/20 px-2 py-0.5 text-xs font-medium whitespace-nowrap text-red-100">
                                  {t.common.over100}
                                </span>
                              )}
                            </span>
                          </td>
                          <td class="py-2">
                            {status !== "active" && (
                              <form method="POST" action={`/api/employees/${employee.id}/invite`}>
                                <button type="submit" class:list={cn(buttonClass, "px-3 py-1 text-xs")}>
                                  {status === "invited" ? t.employees.resendInvite : t.employees.sendInvite}
                                </button>
                              </form>
                            )}
                          </td>
                        </tr>
                        <tr>
                          <td colspan={columnCount} class="pb-3">
                            <details
                              open={rowErrorId === employee.id}
                              class="rounded-xl border border-white/10 bg-white/5 p-3"
                            >
                              <summary class="cursor-pointer text-sm text-purple-300 hover:text-purple-100">
                                {format(t.common.editName, { name: employee.full_name })}
                              </summary>
                              <div class="mt-3">
                                <EmployeeForm
                                  employee={employee}
                                  jobRoles={jobRolesFor(employee)}
                                  supervisors={isAdmin ? supervisors : undefined}
                                  error={rowErrorId === employee.id ? errorMessage : null}
                                />
                              </div>
                            </details>
                          </td>
                        </tr>
                      </tbody>
                    );
                  })}
                </table>
              </div>
            )}
          </section>

          <section
            id="new"
            aria-labelledby="new-heading"
            class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl sm:p-6"
          >
            <h2 id="new-heading" class="text-xl font-semibold">
              {t.employees.registerHeading}
            </h2>
            <p class="mt-1 mb-4 text-sm text-blue-100/60">{t.employees.registerNote}</p>
            <EmployeeForm
              jobRoles={activeJobRoles}
              supervisors={isAdmin ? supervisors : undefined}
              error={registerError}
            />
          </section>
        </div>
      )}
    </div>
  </div>
</Layout>
