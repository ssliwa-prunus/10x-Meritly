---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import EmployeeHistory from "@/components/history/EmployeeHistory.astro";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { createClient } from "@/lib/supabase";
import { groupHistory } from "@/lib/history";
import { getMessages } from "@/lib/i18n";
import { listMyBonuses } from "@/lib/services/approvals";
import type { MyBonuses } from "@/types";

// Middleware limits this page to the employee role, and it reads no query parameters. Figures come
// from the frozen approval snapshot, grouped per project by the shared EmployeeHistory view. It
// shows no share, pool or colleague data.
const t = getMessages(Astro.locals.locale);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let loadError: string | null = null;
let bonuses: MyBonuses = { lines: [], not_linked: false };

if (!supabase) {
  loadError = t.common.supabaseNotConfigured;
} else {
  const result = await listMyBonuses(supabase);
  if (result.error || !result.data) loadError = t.myBonuses.loadFailed;
  else bonuses = result.data;
}

const history = groupHistory(bonuses.lines);
---

<Layout title={t.myBonuses.title}>
  <div class="bg-cosmic text-foreground min-h-screen p-4">
    <div class="mx-auto w-full max-w-4xl">
      <Topbar />
      <h1 class="text-foreground mb-6 text-3xl font-bold">{t.myBonuses.title}</h1>

      {loadError ? (
        <Alert variant="destructive">
          <AlertTitle>{t.myBonuses.loadFailedTitle}</AlertTitle>
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      ) : (
        <section aria-labelledby="bonuses-heading">
          <Card>
            <CardHeader>
              <h2 id="bonuses-heading" class="text-xl leading-none font-semibold">
                {t.myBonuses.approvedHeading}
              </h2>
              <CardDescription>{t.myBonuses.description}</CardDescription>
            </CardHeader>
            <CardContent>
              {bonuses.not_linked ? (
                <p class="bg-muted text-muted-foreground rounded-lg px-3 py-2 text-sm">{t.myBonuses.notLinked}</p>
              ) : (
                <EmployeeHistory history={history} emptyText={t.history.empty} />
              )}
            </CardContent>
          </Card>
        </section>
      )}
    </div>
  </div>
</Layout>
