---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import EmployeeHistory from "@/components/history/EmployeeHistory.astro";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { createClient } from "@/lib/supabase";
import { groupHistory } from "@/lib/history";
import { getMessages } from "@/lib/i18n";
import { listMyBonuses } from "@/lib/services/approvals";
import type { MyBonuses } from "@/types";

// Middleware limits this page to the employee role, and it reads no query parameters. Figures come
// from the frozen approval snapshot, grouped per project by the shared EmployeeHistory view. It
// shows no share, pool or colleague data.
const t = getMessages(Astro.locals.locale);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let loadError: string | null = null;
let bonuses: MyBonuses = { lines: [], not_linked: false };

if (!supabase) {
  loadError = "Supabase is not configured";
} else {
  const result = await listMyBonuses(supabase);
  if (result.error || !result.data) loadError = t.myBonuses.loadFailed;
  else bonuses = result.data;
}

const history = groupHistory(bonuses.lines);
---

<Layout title="My bonuses">
  <div class="bg-cosmic text-foreground min-h-screen p-4">
    <div class="mx-auto w-full max-w-4xl">
      <Topbar />
      <h1 class="text-foreground mb-6 text-3xl font-bold">My bonuses</h1>

      {loadError ? (
        <Alert variant="destructive">
          <AlertTitle>Could not load your bonuses.</AlertTitle>
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      ) : (
        <section aria-labelledby="bonuses-heading">
          <Card>
            <CardHeader>
              <h2 id="bonuses-heading" class="text-xl leading-none font-semibold">
                Approved bonuses
              </h2>
              <CardDescription>
                Your bonus for each approved milestone, grouped by project with a subtotal per project and a total, and
                the figures each bonus was computed from. Approved results are final.
              </CardDescription>
            </CardHeader>
            <CardContent>
              {bonuses.not_linked ? (
                <p class="bg-muted text-muted-foreground rounded-lg px-3 py-2 text-sm">
                  Your account isn't linked to an employee record yet; ask your supervisor to invite you.
                </p>
              ) : (
                <EmployeeHistory history={history} emptyText="No approved bonuses yet." />
              )}
            </CardContent>
          </Card>
        </section>
      )}
    </div>
  </div>
</Layout>
