---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import EngagementForm from "@/components/engagements/EngagementForm.astro";
import ApprovalSection from "@/components/milestones/ApprovalSection.astro";
import KpiScoresSection from "@/components/milestones/KpiScoresSection.astro";
import PayoutSection from "@/components/milestones/PayoutSection.astro";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { createClient } from "@/lib/supabase";
import { formatPercent, formatPln } from "@/lib/format";
import { cn } from "@/lib/utils";
import { approvalErrorMessage, approvalNoticeMessage, getApprovedPayout } from "@/lib/services/approvals";
import { engagementsErrorMessage, listAssignableEmployees, listEngagements } from "@/lib/services/engagements";
import { getMilestonePayout, kpiErrorMessage } from "@/lib/services/payouts";
import { getProject, listMilestones, projectIdSchema } from "@/lib/services/projects";
import type { MilestoneStatus } from "@/types";

const profile = Astro.locals.profile;
const isAdmin = profile?.role === "admin";

const saved = Astro.url.searchParams.get("saved");
const errorCode = Astro.url.searchParams.get("error");
const errorField = Astro.url.searchParams.get("field");
const errorEngagementId = Astro.url.searchParams.get("engagement");
// section=kpi / section=approval mark an error from the KPI or approval form: it shows in that
// card and never in the assignments.
const errorSection = Astro.url.searchParams.get("section");
const isKpiError = errorSection === "kpi";
const isApprovalError = errorSection === "approval";

// The URL carries only codes; the displayed text always comes from fixed catalogs.
const errorMessage =
  errorCode && !isKpiError && !isApprovalError ? engagementsErrorMessage(errorCode, errorField) : null;
const kpiError = errorCode && isKpiError ? kpiErrorMessage(errorCode, errorField) : null;
const approvalError = errorCode && isApprovalError ? approvalErrorMessage(errorCode) : null;
const kpiSaved = saved === "kpi";
const approvalSaved = saved === "approved" || saved === "notified" ? saved : null;
const noticeCode = Astro.url.searchParams.get("notice");
const approvalNotice = approvalSaved && noticeCode ? approvalNoticeMessage(noticeCode) : null;
const SAVED_MESSAGES: Record<string, string> = {
  created: "Employee assigned.",
  updated: "Assignment saved.",
  deleted: "Assignment removed.",
};
const savedMessage = saved !== null && Object.hasOwn(SAVED_MESSAGES, saved) ? SAVED_MESSAGES[saved] : null;

const projectId = projectIdSchema.safeParse(Astro.params.id);
const milestoneId = projectIdSchema.safeParse(Astro.params.milestoneId);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let loadError: string | null = null;
let projectResult: Awaited<ReturnType<typeof getProject>> = {};
let milestonesResult: Awaited<ReturnType<typeof listMilestones>> = {};
let engagementsResult: Awaited<ReturnType<typeof listEngagements>> = {};
let assignableResult: Awaited<ReturnType<typeof listAssignableEmployees>> = {};
let payoutResult: Awaited<ReturnType<typeof getMilestonePayout>> = {};
let approvedAt: string | null = null;
let notifiedCount: number | null = null;
let lineCount: number | null = null;

if (!supabase || !profile) {
  loadError = supabase ? "Your profile could not be loaded" : "Supabase is not configured";
} else if (projectId.success && milestoneId.success) {
  let approvedResult: Awaited<ReturnType<typeof getApprovedPayout>>;
  [projectResult, milestonesResult, engagementsResult, assignableResult, approvedResult] = await Promise.all([
    getProject(supabase, projectId.data),
    listMilestones(supabase, projectId.data),
    listEngagements(supabase, milestoneId.data),
    // Admins are read-only, so they get no picker. A Supervisor picks only employees they own.
    isAdmin ? Promise.resolve({}) : listAssignableEmployees(supabase, profile.id, milestoneId.data),
    // The frozen snapshot, if any, loads in parallel; a Draft milestone simply has none.
    getApprovedPayout(supabase, milestoneId.data),
  ]);
  loadError =
    projectResult.error ?? milestonesResult.error ?? engagementsResult.error ?? assignableResult.error ?? null;

  // The payout source depends on the status: an approved milestone renders its frozen snapshot,
  // every other one the live Draft computation (one extra round trip, Draft only).
  const loadedMilestone = projectResult.data
    ? milestonesResult.data?.find((row) => row.id === milestoneId.data)
    : undefined;
  if (!loadError && loadedMilestone) {
    if (loadedMilestone.status === "approved") {
      const approved = approvedResult.data;
      if (approved) {
        payoutResult = { data: { summary: approved.summary, lines: approved.lines } };
        approvedAt = approved.approved_at;
        notifiedCount = approved.notified_count;
        lineCount = approved.line_count;
      } else {
        if (!approvedResult.error) {
          // An approved milestone always has a header (approve_milestone writes both in one
          // statement), so a missing one is a broken invariant or an RLS gap: surface it.
          // eslint-disable-next-line no-console -- intentional: surfaces the broken invariant in Workers observability logs
          console.error("Approved milestone has no snapshot header", { milestoneId: milestoneId.data });
        }
        payoutResult = { error: approvedResult.error ?? "Could not load bonuses. Please try again." };
      }
    } else {
      payoutResult = await getMilestonePayout(supabase, milestoneId.data);
    }
  }
}

// A payout failure stays in its own card: the details and assignments (where the data is fixed) still render.
const payoutError = payoutResult.error ?? null;

// Invalid ids, a missing milestone, one of another project and one hidden by RLS all look the same: not found.
const project = projectResult.data ?? null;
const milestone =
  project && milestoneId.success ? (milestonesResult.data?.find((row) => row.id === milestoneId.data) ?? null) : null;
const engagements = engagementsResult.data ?? [];
const assignable = assignableResult.data ?? [];
const payoutSummary = payoutResult.data?.summary ?? null;
const payoutLines = payoutResult.data?.lines ?? [];

const isClosedStatus = (status: MilestoneStatus) =>
  status === "completed" || status === "cancelled" || status === "approved";
const isApproved = milestone?.status === "approved";
const isClosed =
  project !== null && milestone !== null && (isClosedStatus(milestone.status) || isClosedStatus(project.status));
const canEdit = !isAdmin && !isClosed;

// KPI scores: a completed milestone can still be scored (only its assignments freeze); an approved
// or cancelled milestone or a closed project cannot. Admins are read-only.
const kpiReadOnlyReason = isApproved
  ? "Approved milestones are frozen; their KPI scores can't be changed."
  : isAdmin
    ? "Admins can view KPI scores but not change them."
    : milestone?.status === "cancelled"
      ? "This milestone is cancelled; its scores can't be changed."
      : project && isClosedStatus(project.status)
        ? `This project is ${project.status}. Reopen it before changing KPI scores.`
        : null;
const canEditKpi = project !== null && milestone !== null && kpiReadOnlyReason === null;

// Approval: the owning Supervisor approves a scored milestone with at least one engagement, from any
// open status, while the project is open. approve_milestone enforces the same rules (MR014, MR015,
// MR003, 42501); this only explains up front why there is no Approve button.
const approvalBlockedReason =
  !project || !milestone || isApproved
    ? null
    : isAdmin
      ? "Admins can view approvals but not approve milestones."
      : milestone.status === "cancelled"
        ? "This milestone is cancelled; it cannot be approved."
        : project.status === "completed" || project.status === "cancelled"
          ? `This project is ${project.status}. Reopen it before approving its milestones.`
          : !payoutSummary
            ? "The computed bonuses could not be loaded; reload the page before approving."
            : !payoutSummary.scored
              ? "Enter all four KPI scores before approving."
              : payoutSummary.engagement_count === 0
                ? "Assign at least one employee before approving."
                : null;
const canApprove = project !== null && milestone !== null && !isApproved && approvalBlockedReason === null;

// Where an error shows: on the failing row, on the add form, or at the top of the page.
const rowErrorId =
  canEdit && errorMessage && engagements.some((engagement) => engagement.id === errorEngagementId)
    ? errorEngagementId
    : null;
const addFormError = canEdit && errorEngagementId === null ? errorMessage : null;
const pageError = rowErrorId === null && addFormError === null ? errorMessage : null;

const columnCount = canEdit ? 6 : 5;
const focusRing = "rounded-sm focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50";
---

<Layout title={milestone ? milestone.name : "Milestone"}>
  <div class="bg-cosmic text-foreground min-h-screen p-4">
    <div class="mx-auto w-full max-w-4xl">
      <Topbar />
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="text-foreground min-w-0 text-3xl font-bold break-words">
          {milestone ? milestone.name : "Milestone"}
        </h1>
        <a
          href={project ? `/projects/${project.id}` : "/projects"}
          class:list={cn("text-primary text-sm hover:underline", focusRing)}
        >
          {project ? `Back to ${project.name}` : "Back to projects"}
        </a>
      </div>

      {savedMessage && (
        <Alert variant="success" role="status" className="mb-6">
          <AlertDescription>{savedMessage}</AlertDescription>
        </Alert>
      )}
      {pageError && (
        <Alert variant="destructive" className="mb-6">
          <AlertDescription>{pageError}</AlertDescription>
        </Alert>
      )}

      {loadError ? (
        <Alert variant="destructive">
          <AlertTitle>Could not load the milestone.</AlertTitle>
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      ) : !project || !milestone ? (
        <Card>
          <CardHeader>
            <CardTitle>Milestone not found.</CardTitle>
            <CardDescription>It does not exist or you do not have access to it.</CardDescription>
          </CardHeader>
        </Card>
      ) : (
        <div class="flex flex-col gap-6">
          <section aria-labelledby="details-heading">
            <Card>
              <CardContent>
                <h2 id="details-heading" class="sr-only">
                  Milestone details
                </h2>
                <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-3">
                  <div>
                    <dt class="text-muted-foreground">Period</dt>
                    <dd class="mt-1">
                      <span class="whitespace-nowrap">{milestone.start_date}</span> –{" "}
                      <span class="whitespace-nowrap">{milestone.end_date}</span>
                    </dd>
                  </div>
                  <div>
                    <dt class="text-muted-foreground">Status</dt>
                    <dd class="mt-1">
                      {isApproved ? (
                        <Badge className="bg-success text-success-foreground">Approved</Badge>
                      ) : (
                        <Badge variant="secondary" className="capitalize">
                          {milestone.status}
                        </Badge>
                      )}
                    </dd>
                  </div>
                  <div>
                    <dt class="text-muted-foreground">Target pool</dt>
                    <dd class="mt-1 tabular-nums">{formatPln(milestone.target_pool)}</dd>
                  </div>
                </dl>
                {milestone.notes && (
                  <p class="text-muted-foreground mt-3 text-xs whitespace-pre-line">{milestone.notes}</p>
                )}
              </CardContent>
            </Card>
          </section>

          {payoutSummary && (
            <KpiScoresSection
              projectId={project.id}
              milestoneId={milestone.id}
              scores={payoutSummary}
              canEdit={canEditKpi}
              readOnlyReason={kpiReadOnlyReason}
              saved={kpiSaved}
              error={kpiError}
            />
          )}
          {payoutSummary && <PayoutSection summary={payoutSummary} lines={payoutLines} approvedAt={approvedAt} />}
          {payoutError && (
            <section aria-labelledby="bonuses-heading">
              <Card>
                <CardHeader>
                  <h2 id="bonuses-heading" class="text-xl leading-none font-semibold">
                    Computed bonuses
                  </h2>
                </CardHeader>
                <CardContent>
                  <Alert variant="destructive">
                    <AlertDescription>{payoutError}</AlertDescription>
                  </Alert>
                </CardContent>
              </Card>
            </section>
          )}

          <ApprovalSection
            projectId={project.id}
            milestoneId={milestone.id}
            status={milestone.status}
            canApprove={canApprove}
            blockedReason={approvalBlockedReason}
            approvedAt={approvedAt}
            notifiedCount={notifiedCount}
            lineCount={lineCount}
            canNotify={!isAdmin}
            saved={approvalSaved}
            notice={approvalNotice}
            error={approvalError}
          />

          <section id="assignments" aria-labelledby="assignments-heading">
            <Card>
              <CardHeader>
                <h2 id="assignments-heading" class="text-xl leading-none font-semibold">
                  Assignments
                </h2>
                <CardDescription>
                  The open total is the employee's time share across milestones that are not completed, cancelled or
                  approved, in projects that are still open. Above 100% is a warning only.
                </CardDescription>
              </CardHeader>

              <CardContent className="flex flex-col gap-4">
                {isAdmin ? (
                  <p class="bg-muted text-muted-foreground rounded-lg px-3 py-2 text-sm">
                    Admins can view assignments but not change them.
                  </p>
                ) : (
                  isClosed &&
                  (isApproved ? (
                    <p class="bg-muted text-muted-foreground rounded-lg px-3 py-2 text-sm">
                      Approved milestones are frozen; assignments can no longer change.
                    </p>
                  ) : (
                    <p class="bg-muted text-muted-foreground rounded-lg px-3 py-2 text-sm">
                      {isClosedStatus(milestone.status)
                        ? `This milestone is ${milestone.status}.`
                        : `This project is ${project.status}.`}{" "}
                      Reopen it (set it to planned or active) before changing its assignments.
                    </p>
                  ))
                )}

                {engagements.length === 0 ? (
                  <p class="text-muted-foreground text-sm">No employees assigned yet.</p>
                ) : (
                  <Table className="min-w-xl text-left">
                    <TableHeader>
                      <TableRow className="hover:bg-transparent">
                        <TableHead scope="col" className="text-muted-foreground">
                          Employee
                        </TableHead>
                        <TableHead scope="col" className="text-muted-foreground">
                          Job role
                        </TableHead>
                        <TableHead scope="col" className="text-muted-foreground text-right">
                          Time share
                        </TableHead>
                        <TableHead scope="col" className="text-muted-foreground text-right">
                          Rating
                        </TableHead>
                        <TableHead scope="col" className="text-muted-foreground text-right">
                          {isAdmin ? "Open total (all milestones)" : "Open total (your milestones)"}
                        </TableHead>
                        {canEdit && (
                          <TableHead scope="col" className="text-muted-foreground">
                            <span class="sr-only">Delete</span>
                          </TableHead>
                        )}
                      </TableRow>
                    </TableHeader>
                    {engagements.map((engagement) => {
                      const name = engagement.employee_name ?? "Former team member";
                      return (
                        <TableBody className="border-b">
                          <TableRow className="border-0 align-top hover:bg-transparent">
                            <TableCell
                              className={cn(
                                "align-top break-words whitespace-normal",
                                engagement.employee_name === null && "italic",
                              )}
                            >
                              {name}
                            </TableCell>
                            <TableCell className="align-top whitespace-normal">
                              {engagement.job_role_name ?? "—"}
                            </TableCell>
                            <TableCell className="text-right align-top tabular-nums">
                              {formatPercent(engagement.time_share)}
                            </TableCell>
                            <TableCell className="text-right align-top tabular-nums">{engagement.rating}</TableCell>
                            <TableCell className="text-right align-top tabular-nums">
                              <span class="inline-flex items-center gap-2">
                                {formatPercent(engagement.open_total)}
                                {engagement.over_allocated && <Badge variant="destructive">Over 100%</Badge>}
                              </span>
                            </TableCell>
                            {canEdit && (
                              <TableCell className="text-right align-top">
                                <form
                                  method="POST"
                                  action={`/api/projects/${project.id}/milestones/${milestone.id}/engagements/${engagement.id}/delete`}
                                >
                                  <Button
                                    type="submit"
                                    variant="outline"
                                    size="sm"
                                    aria-label={`Delete assignment of ${name}`}
                                  >
                                    Delete
                                  </Button>
                                </form>
                              </TableCell>
                            )}
                          </TableRow>
                          {canEdit && (
                            <TableRow className="border-0 hover:bg-transparent">
                              <TableCell colSpan={columnCount} className="pt-0 pb-3 whitespace-normal">
                                <details open={rowErrorId === engagement.id} class="bg-muted rounded-xl border p-3">
                                  <summary
                                    class:list={cn("text-primary cursor-pointer text-sm hover:underline", focusRing)}
                                  >
                                    Edit {name}
                                  </summary>
                                  <div class="mt-3">
                                    <EngagementForm
                                      projectId={project.id}
                                      milestoneId={milestone.id}
                                      engagement={engagement}
                                      error={rowErrorId === engagement.id ? errorMessage : null}
                                    />
                                  </div>
                                </details>
                              </TableCell>
                            </TableRow>
                          )}
                        </TableBody>
                      );
                    })}
                  </Table>
                )}

                {canEdit && (
                  <div class="mt-2 border-t pt-5">
                    <h3 class="text-muted-foreground mb-2 text-sm font-medium tracking-wide uppercase">
                      Assign employee
                    </h3>
                    {assignable.length === 0 && !addFormError ? (
                      <p class="text-muted-foreground text-sm">
                        None of your employees is left to assign to this milestone. Register employees on the{" "}
                        <a href="/employees" class:list={cn("text-primary hover:underline", focusRing)}>
                          Employees
                        </a>{" "}
                        page.
                      </p>
                    ) : (
                      <EngagementForm
                        projectId={project.id}
                        milestoneId={milestone.id}
                        employees={assignable}
                        error={addFormError}
                      />
                    )}
                  </div>
                )}
              </CardContent>
            </Card>
          </section>
        </div>
      )}
    </div>
  </div>
</Layout>
