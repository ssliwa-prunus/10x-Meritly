---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import BudgetExposurePanel from "@/components/projects/BudgetExposurePanel.astro";
import MilestonesSection from "@/components/projects/MilestonesSection.astro";
import ProjectForm from "@/components/projects/ProjectForm.astro";
import { createClient } from "@/lib/supabase";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import {
  getProject,
  getProjectExposure,
  listMilestones,
  listSupervisors,
  projectIdSchema,
  projectsErrorMessage,
  type ProjectSection,
} from "@/lib/services/projects";

const isAdmin = Astro.locals.profile?.role === "admin";

const saved = Astro.url.searchParams.get("saved");
const errorCode = Astro.url.searchParams.get("error");
const errorField = Astro.url.searchParams.get("field");
const section = Astro.url.searchParams.get("section");
const errorMilestoneId = Astro.url.searchParams.get("milestone");

// The URL carries only an error code; the displayed text always comes from the fixed catalog.
const errorMessage = errorCode ? projectsErrorMessage(errorCode, errorField) : null;
const statusFor = (name: ProjectSection) => ({
  saved: saved === name,
  error: section === name ? errorMessage : null,
});
const pageError = section === null ? errorMessage : null;

const id = projectIdSchema.safeParse(Astro.params.id);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let loadError: string | null = null;
let projectResult: Awaited<ReturnType<typeof getProject>> = {};
let milestonesResult: Awaited<ReturnType<typeof listMilestones>> = {};
let exposureResult: Awaited<ReturnType<typeof getProjectExposure>> = {};
let supervisorsResult: Awaited<ReturnType<typeof listSupervisors>> = {};

if (!supabase) {
  loadError = "Supabase is not configured";
} else if (id.success) {
  [projectResult, milestonesResult, exposureResult, supervisorsResult] = await Promise.all([
    getProject(supabase, id.data),
    listMilestones(supabase, id.data),
    getProjectExposure(supabase, id.data),
    isAdmin ? listSupervisors(supabase) : Promise.resolve({}),
  ]);
  loadError = projectResult.error ?? milestonesResult.error ?? exposureResult.error ?? supervisorsResult.error ?? null;
}

// An invalid id, a missing project and one hidden by RLS all look the same: not found.
const project = id.success ? (projectResult.data ?? null) : null;
const milestones = milestonesResult.data ?? [];
const supervisors = supervisorsResult.data;

const isClosed = project?.status === "completed" || project?.status === "cancelled";
const canEditMilestones = !isAdmin && !isClosed;

// Where the milestones error shows: on the failing row, on the add form, or at the top of the section.
const milestonesStatus = statusFor("milestones");
const rowErrorId =
  canEditMilestones && milestonesStatus.error && milestones.some((milestone) => milestone.id === errorMilestoneId)
    ? errorMilestoneId
    : null;
const addFormError = canEditMilestones && errorMilestoneId === null ? milestonesStatus.error : null;
const sectionError = rowErrorId || addFormError ? null : milestonesStatus.error;
---

<Layout title={project ? project.name : "Project"}>
  <div class="bg-cosmic text-foreground min-h-screen p-4">
    <div class="mx-auto w-full max-w-4xl">
      <Topbar />
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="text-foreground min-w-0 text-3xl font-bold break-words">{project ? project.name : "Project"}</h1>
        <a
          href="/projects"
          class="text-primary focus-visible:ring-ring/50 rounded-sm text-sm hover:underline focus-visible:ring-3 focus-visible:outline-none"
        >
          Back to projects
        </a>
      </div>

      {pageError && (
        <Alert variant="destructive" className="mb-6">
          <AlertDescription>{pageError}</AlertDescription>
        </Alert>
      )}

      {loadError ? (
        <Alert variant="destructive">
          <AlertTitle>Could not load the project.</AlertTitle>
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      ) : !project ? (
        <Card>
          <CardHeader>
            <CardTitle>Project not found.</CardTitle>
            <CardDescription>It does not exist or you do not have access to it.</CardDescription>
          </CardHeader>
        </Card>
      ) : (
        <div class="flex flex-col gap-6">
          <BudgetExposurePanel exposure={exposureResult.data ?? null} />

          <MilestonesSection
            project={project}
            milestones={milestones}
            isAdmin={isAdmin}
            canEditMilestones={canEditMilestones}
            saved={milestonesStatus.saved}
            sectionError={sectionError}
            rowErrorId={rowErrorId}
            rowError={rowErrorId ? milestonesStatus.error : null}
            addFormError={addFormError}
          />

          <ProjectForm project={project} supervisors={isAdmin ? supervisors : undefined} {...statusFor("project")} />
        </div>
      )}
    </div>
  </div>
</Layout>
