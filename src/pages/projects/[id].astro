---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import BudgetExposurePanel from "@/components/projects/BudgetExposurePanel.astro";
import MilestoneForm from "@/components/projects/MilestoneForm.astro";
import ProjectForm from "@/components/projects/ProjectForm.astro";
import { createClient } from "@/lib/supabase";
import { formatPln } from "@/lib/format";
import { cn } from "@/lib/utils";
import { getBonusSettings } from "@/lib/services/bonus-config";
import {
  getProject,
  getProjectExposure,
  listMilestones,
  listSupervisors,
  projectIdSchema,
  projectsErrorMessage,
  type ProjectSection,
} from "@/lib/services/projects";

const isAdmin = Astro.locals.profile?.role === "admin";

const saved = Astro.url.searchParams.get("saved");
const errorCode = Astro.url.searchParams.get("error");
const errorField = Astro.url.searchParams.get("field");
const section = Astro.url.searchParams.get("section");
const errorMilestoneId = Astro.url.searchParams.get("milestone");

// The URL carries only an error code; the displayed text always comes from the fixed catalog.
const errorMessage = errorCode ? projectsErrorMessage(errorCode, errorField) : null;
const statusFor = (name: ProjectSection) => ({
  saved: saved === name,
  error: section === name ? errorMessage : null,
});
const pageError = section === null ? errorMessage : null;

const id = projectIdSchema.safeParse(Astro.params.id);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let loadError: string | null = null;
let projectResult: Awaited<ReturnType<typeof getProject>> = {};
let milestonesResult: Awaited<ReturnType<typeof listMilestones>> = {};
let exposureResult: Awaited<ReturnType<typeof getProjectExposure>> = {};
let settingsResult: Awaited<ReturnType<typeof getBonusSettings>> = {};
let supervisorsResult: Awaited<ReturnType<typeof listSupervisors>> = {};

if (!supabase) {
  loadError = "Supabase is not configured";
} else if (id.success) {
  [projectResult, milestonesResult, exposureResult, settingsResult, supervisorsResult] = await Promise.all([
    getProject(supabase, id.data),
    listMilestones(supabase, id.data),
    getProjectExposure(supabase, id.data),
    getBonusSettings(supabase),
    isAdmin ? listSupervisors(supabase) : Promise.resolve({}),
  ]);
  loadError =
    projectResult.error ??
    milestonesResult.error ??
    exposureResult.error ??
    settingsResult.error ??
    supervisorsResult.error ??
    null;
}

// An invalid id, a missing project and one hidden by RLS all look the same: not found.
const project = id.success ? (projectResult.data ?? null) : null;
const milestones = milestonesResult.data ?? [];
const settings = settingsResult.data;
const supervisors = supervisorsResult.data;

const isClosed = project?.status === "completed" || project?.status === "cancelled";
const canEditMilestones = !isAdmin && !isClosed;

// Where the milestones error shows: on the failing row, on the add form, or at the top of the section.
const milestonesStatus = statusFor("milestones");
const rowErrorId =
  canEditMilestones && milestonesStatus.error && milestones.some((milestone) => milestone.id === errorMilestoneId)
    ? errorMilestoneId
    : null;
const addFormError = canEditMilestones && errorMilestoneId === null ? milestonesStatus.error : null;
const sectionError = rowErrorId || addFormError ? null : milestonesStatus.error;
---

<Layout title={project ? project.name : "Project"}>
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto w-full max-w-4xl">
      <Topbar />
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="min-w-0 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold break-words text-transparent">
          {project ? project.name : "Project"}
        </h1>
        <a href="/projects" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Back to projects
        </a>
      </div>

      {pageError && (
        <p role="alert" class="mb-6 rounded-lg bg-red-500/15 px-3 py-2 text-sm text-red-100">
          {pageError}
        </p>
      )}

      {loadError || (project && !settings) ? (
        <div role="alert" class="rounded-2xl border border-red-400/40 bg-red-500/15 p-6 text-red-100">
          <p class="font-semibold">Could not load the project.</p>
          <p class="mt-1 text-sm text-red-100/80">{loadError ?? "Unknown error"}</p>
        </div>
      ) : !project || !settings ? (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
          <p class="font-semibold">Project not found.</p>
          <p class="mt-1 text-sm text-blue-100/60">It does not exist or you do not have access to it.</p>
        </div>
      ) : (
        <div class="flex flex-col gap-6">
          <ProjectForm project={project} supervisors={isAdmin ? supervisors : undefined} {...statusFor("project")} />

          <BudgetExposurePanel exposure={exposureResult.data ?? null} multiplierMax={settings.multiplier_max} />

          <section
            id="milestones"
            aria-labelledby="milestones-heading"
            class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl sm:p-6"
          >
            <h2 id="milestones-heading" class="text-xl font-semibold">
              Milestones
            </h2>
            <p class="mt-1 text-sm text-blue-100/60">
              Each milestone's period must lie within the project's ({project.start_date} – {project.end_date}).
              Cancelled milestones are not reserved in the budget.
            </p>

            {milestonesStatus.saved && (
              <p role="status" class="mt-3 rounded-lg bg-emerald-500/15 px-3 py-2 text-sm text-emerald-100">
                Milestones saved.
              </p>
            )}
            {sectionError && (
              <p role="alert" class="mt-3 rounded-lg bg-red-500/15 px-3 py-2 text-sm text-red-100">
                {sectionError}
              </p>
            )}
            {isAdmin ? (
              <p class="mt-3 rounded-lg bg-white/5 px-3 py-2 text-sm text-blue-100/80">
                Admins can view milestones but not change them.
              </p>
            ) : (
              isClosed && (
                <p class="mt-3 rounded-lg bg-white/5 px-3 py-2 text-sm text-blue-100/80">
                  This project is {project.status}. Reopen the project (set it to planned or active) before adding or
                  changing its milestones.
                </p>
              )
            )}

            {milestones.length === 0 ? (
              <p class="mt-4 text-sm text-blue-100/60">No milestones yet.</p>
            ) : (
              <div class="mt-4 overflow-x-auto">
                <table class="w-full text-left text-sm">
                  <thead class="text-blue-100/70">
                    <tr class="border-b border-white/10">
                      <th scope="col" class="py-2 pr-3 font-medium">
                        Name
                      </th>
                      <th scope="col" class="py-2 pr-3 font-medium">
                        Period
                      </th>
                      <th scope="col" class="py-2 pr-3 font-medium">
                        Status
                      </th>
                      <th scope="col" class="py-2 text-right font-medium">
                        Target pool
                      </th>
                    </tr>
                  </thead>
                  {milestones.map((milestone) => (
                    <tbody class="border-b border-white/5">
                      <tr class="align-top">
                        <td class="py-2 pr-3 break-words">
                          <a
                            href={`/projects/${project.id}/milestones/${milestone.id}`}
                            class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                          >
                            {milestone.name}
                          </a>
                        </td>
                        <td class="py-2 pr-3 text-blue-100/80">
                          <span class="whitespace-nowrap">{milestone.start_date}</span> –{" "}
                          <span class="whitespace-nowrap">{milestone.end_date}</span>
                        </td>
                        <td class:list={cn("py-2 pr-3 capitalize", milestone.status === "cancelled" && "opacity-60")}>
                          {milestone.status}
                        </td>
                        <td class="py-2 text-right whitespace-nowrap tabular-nums">
                          {formatPln(milestone.target_pool)}
                        </td>
                      </tr>
                      {milestone.notes && (
                        <tr>
                          <td colspan="4" class="pb-2 text-xs whitespace-pre-line text-blue-100/60">
                            {milestone.notes}
                          </td>
                        </tr>
                      )}
                      {canEditMilestones && (
                        <tr>
                          <td colspan="4" class="pb-3">
                            <details
                              open={rowErrorId === milestone.id}
                              class="rounded-xl border border-white/10 bg-white/5 p-3"
                            >
                              <summary class="cursor-pointer text-sm text-purple-300 hover:text-purple-100">
                                Edit {milestone.name}
                              </summary>
                              <div class="mt-3">
                                <MilestoneForm
                                  projectId={project.id}
                                  milestone={milestone}
                                  error={rowErrorId === milestone.id ? milestonesStatus.error : null}
                                />
                              </div>
                            </details>
                          </td>
                        </tr>
                      )}
                    </tbody>
                  ))}
                </table>
              </div>
            )}

            {canEditMilestones && (
              <div class="mt-6 border-t border-white/10 pt-5">
                <h3 class="mb-2 text-sm font-medium tracking-wide text-blue-100/70 uppercase">Add milestone</h3>
                <MilestoneForm projectId={project.id} error={addFormError} />
              </div>
            )}
          </section>
        </div>
      )}
    </div>
  </div>
</Layout>
