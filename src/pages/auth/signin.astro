---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { errorMessage } from "@/lib/auth-errors";
import { getMessages } from "@/lib/i18n";
import { safeNext } from "@/lib/safe-next";

const t = getMessages(Astro.locals.locale);

// The URL carries only an error code; the displayed text always comes from the fixed dictionary
// catalog, so a crafted ?error= link cannot put arbitrary text on the page.
const error = errorMessage(t.auth.signinErrors, Astro.url.searchParams.get("error"), "signin_failed");

// Where to go after sign-in; only a same-origin path is passed on to the form.
const next = safeNext(Astro.url.searchParams.get("next"));
---

<Layout title={t.auth.signin.title}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        {t.auth.signin.heading}
      </h1>
      <SignInForm serverError={error} next={next} labels={t.auth.signInForm} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        {t.auth.signin.noAccount}{" "}
        <a href="/auth/signup" class="text-purple-300 hover:underline">
          {t.common.signUp}
        </a>
      </p>
    </div>
  </div>
</Layout>
