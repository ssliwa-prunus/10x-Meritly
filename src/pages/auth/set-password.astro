---
import Layout from "@/layouts/Layout.astro";
import { buttonClass, inputClass } from "@/components/form-classes";
import { format, getMessages } from "@/lib/i18n";
import { setPasswordErrorMessage } from "@/lib/set-password";
import { cn } from "@/lib/utils";

const locale = Astro.locals.locale;
const t = getMessages(locale).auth.setPassword;

// The URL carries only an error code; the displayed text always comes from the fixed catalog.
const errorCode = Astro.url.searchParams.get("error");
const error = errorCode ? setPasswordErrorMessage(errorCode, locale) : null;
const email = Astro.locals.user?.email;
---

<Layout title={t.title}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        {t.heading}
      </h1>
      <p class="mb-6 text-center text-sm text-blue-100/60">
        {email ? format(t.introForEmail, { email }) : t.introGeneric}
        {t.introSuffix}
      </p>

      {error && (
        <p role="alert" class="mb-4 rounded-lg bg-red-500/15 px-3 py-2 text-sm text-red-100">
          {error}
        </p>
      )}

      <form method="POST" action="/api/auth/set-password" class="flex flex-col gap-4">
        <label class="flex flex-col gap-1 text-sm">
          <span class="text-blue-100/80">{t.newPassword}</span>
          <input
            type="password"
            name="password"
            autocomplete="new-password"
            minlength="6"
            maxlength="72"
            required
            class:list={inputClass}
          />
        </label>
        <label class="flex flex-col gap-1 text-sm">
          <span class="text-blue-100/80">{t.confirmPassword}</span>
          <input
            type="password"
            name="confirm_password"
            autocomplete="new-password"
            minlength="6"
            maxlength="72"
            required
            class:list={inputClass}
          />
        </label>
        <button type="submit" class:list={cn(buttonClass, "w-full")}>
          {t.submit}
        </button>
      </form>
    </div>
  </div>
</Layout>
