---
import Layout from "@/layouts/Layout.astro";
import { getMessages } from "@/lib/i18n";

const { user, profile, locale } = Astro.locals;
const t = getMessages(locale);
const canSeeProjects = profile?.role === "supervisor" || profile?.role === "admin";
const canSeeMyBonuses = profile?.role === "employee";
---

<Layout title={t.dashboard.title}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {t.dashboard.title}
      </h1>
      <p class="text-blue-100/80">
        {t.dashboard.welcome} <span class="font-semibold text-white">{user?.email}</span>
        <span class="ml-2 rounded-full border border-white/20 bg-white/10 px-2 py-0.5 text-xs text-blue-100">
          {profile ? t.status.role[profile.role] : t.dashboard.noRole}
        </span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">{t.dashboard.authOnly}</p>
      {canSeeProjects && (
        <div class="mt-6 flex justify-center gap-3">
          <a
            href="/projects"
            class="inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            {t.layout.nav.projects}
          </a>
          <a
            href="/employees"
            class="inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            {t.layout.nav.employees}
          </a>
        </div>
      )}
      {canSeeMyBonuses && (
        <div class="mt-6 flex justify-center gap-3">
          <a
            href="/my-bonuses"
            class="inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            {t.layout.nav.myBonuses}
          </a>
        </div>
      )}
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          {t.common.signOut}
        </button>
      </form>
    </div>
  </div>
</Layout>
