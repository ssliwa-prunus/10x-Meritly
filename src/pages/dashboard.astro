---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import AttentionList from "@/components/dashboard/AttentionList.astro";
import BonusHistoryPreview from "@/components/dashboard/BonusHistoryPreview.astro";
import DashboardGreeting from "@/components/dashboard/DashboardGreeting.astro";
import EmployeeStats from "@/components/dashboard/EmployeeStats.astro";
import LatestBonusBreakdown from "@/components/dashboard/LatestBonusBreakdown.astro";
import MilestonesTable from "@/components/dashboard/MilestonesTable.astro";
import ProjectBudgets from "@/components/dashboard/ProjectBudgets.astro";
import SupervisorStats from "@/components/dashboard/SupervisorStats.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card } from "@/components/ui/card";
import {
  attentionItems,
  awaitingMilestones,
  dashboardRows,
  employeeStats,
  reservedBudget,
  supervisorStats,
  warsawYearBounds,
} from "@/lib/dashboard";
import { logContextFrom } from "@/lib/error-log";
import { groupHistory } from "@/lib/history";
import { getMessages } from "@/lib/i18n";
import { listMyBonuses } from "@/lib/services/approvals";
import { getBonusSettings } from "@/lib/services/bonus-config";
import { listApprovedResults, listPayoutSummaries, listVisibleMilestones } from "@/lib/services/dashboard";
import { listEmployees } from "@/lib/services/employees";
import { listProjectExposure, listProjects } from "@/lib/services/projects";
import { createClient } from "@/lib/supabase";
import type {
  AttentionItems,
  DashboardMilestoneRow,
  EmployeeStats as EmployeeStatsData,
  MilestonePayoutSummary,
  MyBonusLine,
  Project,
  ProjectExposure,
  ReservedBudget,
  SupervisorStats as SupervisorStatsData,
} from "@/types";

// The dashboard (reports/design/project/Dashboard.dc.html for Supervisor/Admin, DashboardEmployee.dc.html
// for Employee). Every query runs as the signed-in user, so RLS decides the scope: own projects for a
// Supervisor, everything for an Admin, own approved lines for an Employee. The figures are computed by
// src/lib/dashboard.ts; the sections only render them. A failed read (logged by its service) sets only the
// error of the sections that depend on it, and the page still renders.
const { profile, locale } = Astro.locals;
const t = getMessages(locale);
const role = profile?.role ?? null;
const now = new Date();
const { year, fromIso, toIso } = warsawYearBounds(now);

const supabase = role ? createClient(Astro.request.headers, Astro.cookies) : null;
const log = logContextFrom(Astro.locals, Astro.request);

interface ManagerView {
  greetingError: boolean;
  awaitingCount: number;
  overBudgetCount: number;
  stats: SupervisorStatsData;
  reserved: ReservedBudget;
  statsError: boolean;
  rows: DashboardMilestoneRow[];
  tableError: boolean;
  attention: AttentionItems;
  attentionError: boolean;
  projects: Project[];
  exposures: ProjectExposure[];
  budgetsError: boolean;
}

interface EmployeeView {
  notLinked: boolean;
  lines: MyBonusLine[];
  total: number;
  stats: EmployeeStatsData;
  error: boolean;
}

let manager: ManagerView | null = null;
let employee: EmployeeView | null = null;

if (role === "supervisor" || role === "admin") {
  const [projectsResult, exposureResult, milestonesResult, approvedResult, employeesResult, settingsResult] = supabase
    ? await Promise.all([
        listProjects(supabase, log),
        listProjectExposure(supabase, log),
        listVisibleMilestones(supabase, log),
        listApprovedResults(supabase, { fromIso, toIso }, log),
        listEmployees(supabase, {}, log),
        getBonusSettings(supabase, log),
      ])
    : [{}, {}, {}, {}, {}, {}];

  const projects = projectsResult.data ?? [];
  const exposures = exposureResult.data ?? [];
  const milestones = milestonesResult.data ?? [];
  const approvedResults = approvedResult.data ?? [];
  const projectsFailed = !projectsResult.data || !exposureResult.data;
  const milestonesFailed = !milestonesResult.data;
  const approvedFailed = !approvedResult.data;

  // Only scored, unapproved milestones of open projects cost a summary RPC. A failed one would hide an
  // awaiting milestone, so it raises the greeting, stats and attention errors instead of a false zero.
  const { summaries, failed: summariesFailed } =
    supabase && !milestonesFailed
      ? await listPayoutSummaries(supabase, milestones, log)
      : { summaries: new Map<string, MilestonePayoutSummary>(), failed: 0 };
  const awaitingFailed = summariesFailed > 0;
  const awaiting = awaitingMilestones(milestones, summaries);
  // Without bonus_settings the live KPI cells blank ("—", approved rows keep their snapshot), so a failed
  // or missing row raises the table error rather than looking like "not scored yet".
  const multiplierMax = settingsResult.data?.multiplier_max ?? null;
  const settingsFailed = Boolean(settingsResult.error);
  const attention = attentionItems(awaiting, exposures, projects, employeesResult.data ?? []);

  manager = {
    greetingError: projectsFailed || milestonesFailed || awaitingFailed,
    awaitingCount: awaiting.length,
    overBudgetCount: attention.over_budget.length,
    stats: supervisorStats(projects, milestones, awaiting, approvedResults),
    reserved: reservedBudget(projects, exposures),
    statsError: projectsFailed || milestonesFailed || approvedFailed || awaitingFailed,
    rows: dashboardRows(milestones, summaries, approvedResults, role, multiplierMax),
    tableError: milestonesFailed || approvedFailed || settingsFailed,
    attention,
    attentionError: projectsFailed || milestonesFailed || awaitingFailed || !employeesResult.data,
    projects,
    exposures,
    budgetsError: projectsFailed,
  };
}

if (role === "employee") {
  const result = supabase ? await listMyBonuses(supabase, log) : {};
  const lines = result.data?.lines ?? [];
  employee = {
    notLinked: result.data?.not_linked ?? false,
    lines,
    total: groupHistory(lines).total,
    stats: employeeStats(lines, now),
    error: !result.data,
  };
}
---

<Layout title={t.dashboard.title} languageSwitch={false}>
  <div class="bg-cosmic text-foreground min-h-screen p-4">
    <div class="mx-auto w-full max-w-7xl">
      <Topbar current="dashboard" />
      <main class="flex flex-col gap-7 pb-16 sm:pt-3">
        {manager && (role === "supervisor" || role === "admin") && (
          <>
            <DashboardGreeting
              viewerRole={role}
              awaiting={manager.awaitingCount}
              overBudget={manager.overBudgetCount}
              error={manager.greetingError}
              locale={locale}
            />
            <SupervisorStats
              stats={manager.stats}
              reserved={manager.reserved}
              year={year}
              error={manager.statsError}
              locale={locale}
            />
            <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
              <div class="min-w-0 lg:col-span-2">
                <MilestonesTable rows={manager.rows} error={manager.tableError} locale={locale} />
              </div>
              <div class="flex min-w-0 flex-col gap-6">
                <AttentionList
                  items={manager.attention}
                  viewerRole={role}
                  error={manager.attentionError}
                  locale={locale}
                />
                <ProjectBudgets
                  projects={manager.projects}
                  exposures={manager.exposures}
                  error={manager.budgetsError}
                  locale={locale}
                />
              </div>
            </div>
          </>
        )}

        {employee && (
          <>
            <DashboardGreeting viewerRole="employee" locale={locale} />
            {employee.notLinked ? (
              <Card className="rounded-2xl px-6">
                <p class="bg-muted text-muted-foreground rounded-lg px-3 py-2 text-sm">{t.myBonuses.notLinked}</p>
              </Card>
            ) : (
              <>
                <EmployeeStats stats={employee.stats} error={employee.error} locale={locale} />
                <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-2">
                  <LatestBonusBreakdown line={employee.stats.latest} error={employee.error} locale={locale} />
                  <BonusHistoryPreview
                    lines={employee.lines}
                    total={employee.total}
                    error={employee.error}
                    locale={locale}
                  />
                </div>
              </>
            )}
          </>
        )}

        {!role && (
          <Card className="mx-auto w-full max-w-xl rounded-2xl px-6">
            <h1 class="font-heading text-2xl font-bold tracking-tight">{t.dashboard.title}</h1>
            <Alert>
              <AlertDescription>
                <p class="text-foreground font-medium">{t.dashboard.noRoleTitle}</p>
                <p>{t.dashboard.noRole}</p>
              </AlertDescription>
            </Alert>
          </Card>
        )}
      </main>
    </div>
  </div>
</Layout>
