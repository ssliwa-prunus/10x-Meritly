---
import "../styles/global.css";
import { SUPABASE_KEY, SUPABASE_URL } from "astro:env/server";
import Banner from "@/components/Banner.astro";
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import { missingConfigs } from "@/lib/config-status";
import { getMessages } from "@/lib/i18n";

interface Props {
  title?: string;
}

const locale = Astro.locals.locale;
const t = getMessages(locale);
const { title = t.common.appName } = Astro.props;
const missing = missingConfigs({ supabaseUrl: SUPABASE_URL, supabaseKey: SUPABASE_KEY }, locale);
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {missing.map((cfg) => (
      <Banner variant="error">
        <strong>{t.layout.bannerAttention}</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? t.layout.bannerDocs}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
    <LanguageSwitch />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
