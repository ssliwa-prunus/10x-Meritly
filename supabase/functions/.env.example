# Edge Function secrets for local development. Copy to supabase/functions/.env (gitignored);
# `npx supabase functions serve` loads it. In production set them with `npx supabase secrets set`.

# Production transport (notify-milestone-approved): Resend's batch API. Leave empty locally.
RESEND_API_KEY=
# Sender address on a Resend-verified domain, e.g. "Meritly <bonuses@example.com>". Also the
# Mailpit sender locally; when empty, Mailpit uses "Meritly <no-reply@meritly.local>".
MAIL_FROM=

# Base URL of the app, used for the /my-bonuses link in approval emails.
APP_URL=http://localhost:4321

# Local transport: Mailpit's send API, used only when RESEND_API_KEY or MAIL_FROM is empty. Mail
# lands in the test inbox at http://127.0.0.1:54324. If the edge runtime container cannot reach
# host.docker.internal, use the inbucket container directly (it listens on 8025, mapped to host
# 54324): MAILPIT_URL=http://supabase_inbucket_10x-astro-starter:8025
MAILPIT_URL=http://host.docker.internal:54324
